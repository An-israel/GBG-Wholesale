[
  {
    "name": "theme_info",
    "theme_name": "GBG Wholesale Hub",
    "theme_version": "1.0.0",
    "theme_author": "GBG Wholesale Hub",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 260,
        "step": 5,
        "unit": "px",
        "label": "Logo width (desktop)",
        "default": 150
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colours",
    "settings": [
      {
        "type": "paragraph",
        "content": "The GBG palette from the brand identity: navy and amber, on white, with black ink for type. Choose which of the two leads on buttons and links below."
      },
      {
        "type": "header",
        "content": "Brand"
      },
      {
        "type": "color",
        "id": "color_navy",
        "label": "Navy (primary brand colour)",
        "default": "#001A3F"
      },
      {
        "type": "color",
        "id": "color_amber",
        "label": "Amber (secondary brand colour)",
        "default": "#FFB303"
      },
      {
        "type": "color",
        "id": "color_amber_soft",
        "label": "Amber tint (soft highlight backgrounds)",
        "default": "#FFEBBC"
      },
      {
        "type": "color",
        "id": "color_aqua",
        "label": "Aqua (rare accent, used sparingly)",
        "default": "#60FFEF"
      },
      {
        "type": "select",
        "id": "accent_color",
        "label": "Lead colour for buttons and links",
        "info": "Navy reads as authority and is the safer default. Amber is louder and pushes harder on calls to action.",
        "options": [
          {
            "value": "navy",
            "label": "Navy"
          },
          {
            "value": "amber",
            "label": "Amber"
          }
        ],
        "default": "navy"
      },
      {
        "type": "header",
        "content": "Core"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Ink (body text, headlines)",
        "default": "#121212"
      },
      {
        "type": "color",
        "id": "color_paper",
        "label": "Paper (page background)",
        "default": "#F4F6F9"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface (cards, product tiles)",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border and rule lines",
        "default": "#DDE3EA"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text (captions, meta)",
        "default": "#565656"
      },
      {
        "type": "header",
        "content": "Feedback"
      },
      {
        "type": "color",
        "id": "color_error",
        "label": "Error and form validation",
        "default": "#B3261E"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1100,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Max page width",
        "default": 1360
      },
      {
        "type": "range",
        "id": "corner_radius",
        "min": 0,
        "max": 20,
        "step": 2,
        "unit": "px",
        "label": "Card / button corner radius",
        "default": 10
      }
    ]
  },
  {
    "name": "WhatsApp & community links",
    "settings": [
      {
        "type": "paragraph",
        "content": "These links are pulled from a single setting everywhere they're used sitewide - update once here and every WhatsApp button, SYPB link and Wholesale Hub link on the site updates together."
      },
      {
        "type": "text",
        "id": "whatsapp_link",
        "label": "WhatsApp message link (direct to Lami)",
        "info": "Used for every \"message us\" button, including the floating button. This is a one to one chat, not a group.",
        "default": "https://wa.me/message/4JYCM5LR4LZPD1"
      },
      {
        "type": "checkbox",
        "id": "show_whatsapp_float",
        "label": "Show floating WhatsApp button",
        "default": true
      },
      {
        "type": "text",
        "id": "sypb_link",
        "label": "SYPB community link",
        "info": "The Start Your Product Business WhatsApp group. Used by every SYPB button on the site.",
        "default": "https://chat.whatsapp.com/J8cg43SbFN58hvDQomRpNf?mode=gi_t"
      },
      {
        "type": "text",
        "id": "wholesale_hub_join_link",
        "label": "GBG Wholesale Hub community link",
        "info": "The buyers-only WhatsApp group. Shown on the order and account pages once a customer has bought.",
        "default": "https://chat.whatsapp.com/F4UPdAS2IxNGgT5f65Wude?mode=gi_t"
      }
    ]
  },
  {
    "name": "Announcement bar",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_announcement_bar",
        "label": "Show announcement bar",
        "default": true
      },
      {
        "type": "select",
        "id": "restock_day",
        "label": "Restock day",
        "info": "Confirm with Lami: the actual weekly restock day.",
        "options": [
          {
            "value": "Monday",
            "label": "Monday"
          },
          {
            "value": "Tuesday",
            "label": "Tuesday"
          },
          {
            "value": "Wednesday",
            "label": "Wednesday"
          },
          {
            "value": "Thursday",
            "label": "Thursday"
          },
          {
            "value": "Friday",
            "label": "Friday"
          },
          {
            "value": "Saturday",
            "label": "Saturday"
          },
          {
            "value": "Sunday",
            "label": "Sunday"
          }
        ],
        "default": "Thursday"
      }
    ]
  },
  {
    "name": "Trust & business info",
    "settings": [
      {
        "type": "text",
        "id": "stat_customers_text",
        "label": "Hero stat - community size",
        "default": "600+ women building with GBG"
      },
      {
        "type": "text",
        "id": "stat_price_text",
        "label": "Hero stat - starting price",
        "default": "Packs from £50"
      },
      {
        "type": "text",
        "id": "stat_shipping_text",
        "label": "Hero stat: dispatch",
        "default": "Ships from the UK in 3 days"
      },
      {
        "type": "text",
        "id": "starter_box_min_price",
        "label": "Starter Box minimum price (number only, in pounds)",
        "info": "Used in the FAQ and on the Start Here page.",
        "default": "50"
      },
      {
        "type": "text",
        "id": "dispatch_timeframe",
        "label": "Dispatch and delivery timeframe",
        "info": "Shown on product pages, in the cart, in the FAQ and in the footer. Change it here and it changes everywhere.",
        "default": "Ships from the UK. Standard delivery is 3 working days."
      },
      {
        "type": "text",
        "id": "warehouse_location",
        "label": "Warehouse location",
        "info": "Used in the FAQ and in structured data.",
        "default": "United Kingdom"
      },
      {
        "type": "text",
        "id": "next_webinar_date",
        "label": "Next SYPB live session date",
        "info": "Leave blank and the site says the date is announced inside the group instead."
      }
    ]
  },
  {
    "name": "Support & contact",
    "settings": [
      {
        "type": "text",
        "id": "support_email",
        "label": "Support email",
        "info": "Confirm with Lami: the live support inbox.",
        "default": "hello@gbgwholesalehub.co.uk"
      },
      {
        "type": "text",
        "id": "response_time_text",
        "label": "Response time promise",
        "default": "Within 24 hours everyday except Fridays and Sundays - those are our rest days."
      },
      {
        "type": "text",
        "id": "support_hours_text",
        "label": "Support hours",
        "default": "9:00am-5:00pm"
      }
    ]
  },
  {
    "name": "Founder",
    "settings": [
      {
        "type": "image_picker",
        "id": "founder_photo",
        "label": "Photo of Lami"
      },
      {
        "type": "richtext",
        "id": "founder_note_body",
        "label": "Founder's note (About page + order confirmation)",
        "info": "Launch-ready copy written in Lami's voice. Confirm the final wording with her.",
        "default": "<p>GBG started because I got tired of watching women give up on reselling, not because they weren't capable, but because nobody could give them a straight answer without gatekeeping. I built this to be the source I needed when I started: real stock, honest prices, and someone who actually answers when you ask a question. Every part of this hub - the shop, the guides, the community - comes from that same place. Thank you for being part of it.</p>"
      }
    ]
  },
  {
    "name": "Business details (SEO and structured data)",
    "settings": [
      {
        "type": "text",
        "id": "org_legal_name",
        "label": "Legal / full business name",
        "default": "Global Biz Gateway (GBG Wholesale Hub)"
      },
      {
        "type": "text",
        "id": "org_address_line",
        "label": "Address line (structured data)",
        "info": "Confirm with Lami: the registered / warehouse address.",
        "default": "United Kingdom"
      },
      {
        "type": "text",
        "id": "org_locality",
        "label": "City / locality",
        "info": "Confirm with Lami: the city or locality."
      },
      {
        "type": "text",
        "id": "org_postal_code",
        "label": "Postal code",
        "info": "Confirm with Lami: the postal code."
      },
      {
        "type": "text",
        "id": "org_country",
        "label": "Country",
        "default": "United Kingdom"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_url",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_facebook_url",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_tiktok_url",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_pinterest_url",
        "label": "Pinterest URL"
      }
    ]
  }
]

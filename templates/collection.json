    "faq": {
      "type": "faq-accordion",
      "settings": {
        "background": "paper",
        "group_by_category": false,
        "emit_schema": false,
        "eyebrow": "FAQ",
        "heading": "Before you order",
        "cta_text": "All questions",
        "cta_url": "/pages/faq"
      },
      "blocks": {
        "f1": {
          "type": "question",
          "settings": {
            "question": "How is this collection put together?",
            "answer": "<p>Automatically. Products appear here as soon as they match, and drop out when they no longer do, so what you are looking at is current rather than a list someone updated last month.</p>"
          }
        },
        "f2": {
          "type": "question",
          "settings": {
            "question": "What is the minimum I have to order?",
            "answer": "<p>It is set per product and shown on every card and product page. Anything marked for dropshipping can be ordered as a single unit.</p>",
            "link_text": "See low MOQ products",
            "link_url": "/collections/low-moq"
          }
        },
        "f3": {
          "type": "question",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Everything ships from the UK.</p>",
            "dynamic_append": "dispatch_timeframe"
          }
        },
        "f4": {
          "type": "question",
          "settings": {
            "question": "Will these sell?",
            "answer": "<p>They have sold for other people, which is not the same as a guarantee. What you make depends on your listing, your pricing and demand when you list. The guides are there to improve the odds, not to promise a result.</p>",
            "link_text": "Read the guides",
            "link_url": "/pages/learn"
          }
        },
        "f5": {
          "type": "question",
          "settings": {
            "question": "What if something arrives damaged?",
            "answer": "<p>Tell us within 48 hours with photos and it is replaced or refunded in full.</p>",
            "link_text": "Full returns policy",
            "link_url": "/pages/returns-policy"
          }
        }
      },
      "block_order": ["f1", "f2", "f3", "f4", "f5"]
    },
    "final-cta": {
      "type": "rich-text",
      "settings": {
        "background": "navy",
        "narrow": true,
        "heading": "Keep going.",
        "body": "<p>Not sure which pack suits you? Tell us your budget and where you plan to sell, and we will point you at something.</p>",
        "primary_label": "Continue shopping",
        "primary_link_source": "custom",
        "primary_url": "/collections/all",
        "secondary_label": "Need help choosing?",
        "secondary_link_source": "custom",
        "secondary_url": "/pages/contact"
      }
    }

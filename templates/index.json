    "hero-slider": {
      "type": "hero-slider",
      "settings": {
        "autoplay": true,
        "interval": 6,
        "aria_label": "Buy, sell, build",
        "show_stats": true
      },
      "blocks": {
        "buy": {
          "type": "slide",
          "settings": {
            "eyebrow": "BUY",
            "heading": "Better stock decisions start here.",
            "body": "<p>GBG gives you access to low-MOQ wholesale products, current best sellers and starter-friendly options, so you can choose stock based on your budget and where you plan to sell.</p>",
            "primary_label": "Shop Products",
            "primary_url": "/collections/all",
            "secondary_label": "Shop Under £100",
            "secondary_url": "/collections/under-100",
            "image": "shopify://shop_images/Frame_2147225437.png",
            "image_alt": "Wholesale stock ready to sell",
            "support_line": "Low minimum orders | UK stock available | Secure checkout"
          }
        },
        "sell": {
          "type": "slide",
          "settings": {
            "eyebrow": "SELL",
            "heading": "Turn stock into sales.",
            "body": "<p>From pricing to platforms and product listings, GBG gives you the guidance to take your stock to market with a clearer plan.</p>",
            "primary_label": "Learn How to Sell",
            "primary_url": "/pages/learn",
            "secondary_label": "Shop by Platform",
            "secondary_url": "/collections/best-for-vinted",
            "support_line": "Pricing | Listings | Platforms | Selling support"
          }
        },
        "build": {
          "type": "slide",
          "settings": {
            "eyebrow": "BUILD",
            "heading": "Build beyond the first sale.",
            "body": "<p>Use GBG's education, communities and support to learn, restock and keep building from what you've started.</p>",
            "primary_label": "Find Your Community",
            "primary_url": "/pages/community",
            "secondary_label": "Explore the Academy",
            "secondary_url": "/pages/academy",
            "support_line": "Learn | Restock | Improve | Grow"
          }
        }
      },
      "block_order": [
        "buy",
        "sell",
        "build"
      ]
    },

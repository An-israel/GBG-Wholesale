            "link_url": "/collections/all"
          }
        },
        "f2": {
          "type": "question",
          "settings": {
            "question": "How much do I need to start?",
            "answer": "<p>Starter Boxes are the cheapest way in, and there is no minimum spend beyond each pack's own MOQ.</p>",
            "link_text": "See Starter Boxes",
            "link_url": "/collections/starter-boxes"
          }
        },
        "f3": {
          "type": "question",
          "settings": {
            "question": "Do I need to join the community to shop?",
            "answer": "<p>No. Check out directly, no account and no group needed.</p>",
            "link_text": "Shop the stock",
            "link_url": "/collections/all"
          }
        },
        "f4": {
          "type": "question",
          "settings": {
            "question": "What is the Academy?",
            "answer": "<p>A paid six-module programme with feedback on your own listings and prices, plus a private Skool community.</p>",
            "link_text": "See the Academy",
            "link_url": "/pages/academy"
          }
        }
      },
      "block_order": [
        "f1",
        "f2",
        "f3",
        "f4"

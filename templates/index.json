      "type": "two-column-media",
      "settings": {
        "custom_id": "meet-lami",
        "image_position": "left",
        "eyebrow": "FOUNDER",
        "heading": "Meet Lami",
        "body": "<p>Lami started with a bag of bridal accessories and a WiFi connection in 2016. She learned wholesale the expensive way, then built GBG so you don't have to.</p><p><em>Input equals output. We hand you the stock and the roadmap. The rest is yours to build.</em></p>",
        "link_text": "Read her story",
        "link_url": "/pages/about#founder-story",
        "background": "white",
        "image": "shopify://shop_images/photo_2026-08-19_22-54-05.jpg"

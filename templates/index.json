    "guides-to-stock": {
      "type": "content-cards",
      "settings": {
        "background": "white",
        "columns": "3",
        "eyebrow": "LEARN",
        "heading": "Answers to your hidden questions",
        "body": "<p>Free, no signup. Read one, then buy the stock it points you at.</p>"
      },
      "blocks": {
        "g1": {
          "type": "card",
          "settings": {
            "label": "PLATFORM GUIDE",
            "heading": "Where should I sell this?",
            "body": "<p>What moves on Vinted, eBay, TikTok Shop and Facebook Marketplace, category by category.</p>",
            "link_text": "Read it, then shop jewellery",
            "link_url": "/pages/learn-platform-guide"
          }
        },
        "g2": {
          "type": "card",
          "settings": {
            "label": "PRICING CALCULATOR",
            "heading": "What should I charge?",
            "body": "<p>Put in your pack cost and fees. It gives you the lowest price you can list at without losing money.</p>",
            "link_text": "Open the calculator",
            "link_url": "/pages/faq#pricing-calculator"
          }
        },
        "g3": {
          "type": "card",
          "settings": {
            "label": "LISTINGS GUIDE",
            "heading": "Why isn't it selling?",
            "body": "<p>Titles, photos and descriptions that get found, plus how to read a failing listing.</p>",
            "link_text": "Read it, then shop best sellers",
            "link_url": "/pages/learn-listings-guide"
          }
        }
      },
      "block_order": [
        "g1",
        "g2",
        "g3"
      ]
    },

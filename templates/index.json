    "guides-to-stock": {
      "type": "content-cards",
      "settings": {
        "background": "white",
        "columns": "3",
        "eyebrow": "LEARN",
        "heading": "Three questions, three answers",
        "body": "<p>Free, no signup. Read one, then buy the stock it points you at.</p>"
      },
      "blocks": {
        "g1": {
          "type": "card",
          "settings": {
            "label": "PLATFORM GUIDE",
            "heading": "Where should I sell this?",
            "body": "<p>What moves on Vinted, eBay, TikTok Shop and Facebook Marketplace, category by category.</p>",
            "link_text": "Read it, then shop jewellery",
            "link_url": "/pages/learn-platform-guide"
          }
        },
        "g2": {
          "type": "card",
          "settings": {
            "label": "PRICING CALCULATOR",
            "heading": "What should I charge?",
            "body": "<p>Put in your pack cost and fees. It gives you the lowest price you can list at without losing money.</p>",
            "link_text": "Open the calculator",
            "link_url": "/pages/faq#pricing-calculator"
          }
        },
        "g3": {
          "type": "card",
          "settings": {
            "label": "LISTINGS GUIDE",
            "heading": "Why isn't it selling?",
            "body": "<p>Titles, photos and descriptions that get found, plus how to read a failing listing.</p>",
            "link_text": "Read it, then shop best sellers",
            "link_url": "/pages/learn-listings-guide"
          }
        }
      },
      "block_order": [
        "g1",
        "g2",
        "g3"
      ]
    },
    "community": {
      "type": "image-banner",
      "settings": {
        "height": "compact",
        "align": "left",
        "eyebrow": "COMMUNITY",
        "heading": "Two groups. One journey.",
        "body": "<p>SYPB is free and open to anyone deciding. The Wholesale Hub is buyers only, and your first order lets you in.</p>",
        "primary_label": "Join SYPB, it's free",
        "primary_link_source": "sypb_link"
      }
    },
    "academy-preview": {
      "type": "rich-text",
      "settings": {
        "background": "mist",
        "narrow": true,
        "eyebrow": "ACADEMY",
        "eyebrow_color": "navy",
        "heading": "Want someone checking your actual work?",
        "body": "<p>Six modules, real feedback on your listings and your numbers, and a private Skool community. Join and you are in the same day.</p>",
        "primary_label": "Join the Academy",
        "primary_link_source": "custom",
        "primary_url": "/pages/academy",
        "secondary_label": "Or shop the stock first",
        "secondary_link_source": "custom",
        "secondary_url": "/collections/all"
      }
    },
    "meet-lami": {
      "type": "two-column-media",
      "settings": {
        "custom_id": "meet-lami",
        "image_position": "left",
        "eyebrow": "FOUNDER",
        "heading": "Meet Lami",
        "body": "<p>Lami started with a bag of bridal accessories and a WiFi connection in 2016. She learned wholesale the expensive way, then built GBG so you don't have to.</p><p><em>Input equals output. We hand you the stock and the roadmap. The rest is yours to build.</em></p>",
        "link_text": "Read her story",
        "link_url": "/pages/about#founder-story",
        "background": "white"
      }
    },
    "faq-preview": {
      "type": "faq-accordion",

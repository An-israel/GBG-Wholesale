<div class="container section account-page">
  <div class="account-page__narrow">
    <span class="route-label">ACCOUNT &rarr; NEW PASSWORD</span>
    <h1>Set a new password</h1>
    <p>Choose a new password for {{ email }}.</p>

    {% form 'reset_customer_password' %}
      {% if form.errors %}
        <div class="form-status" data-state="error">{{ form.errors | default_errors }}</div>
      {% endif %}

      <div class="field">
        <label class="field__label" for="ResetPassword">New password</label>
        <input class="input" type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label class="field__label" for="ResetPasswordConfirm">Confirm new password</label>
        <input class="input" type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>

      <button type="submit" class="btn btn--primary btn--block">Save password</button>
    {% endform %}
  </div>
</div>

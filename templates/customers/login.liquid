<div class="container section account-page">
  <div class="account-page__narrow" id="login" data-login-panel>
    <span class="route-label">ACCOUNT &rarr; SIGN IN</span>
    <h1>{{ 'customers.login.title' | t }}</h1>

    {% form 'customer_login' %}
      {% if form.errors %}
        <div class="form-status" data-state="error">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div class="field">
        <label class="field__label" for="CustomerEmail">{{ 'customers.login.email' | t }}</label>
        <input class="input" type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" required>
      </div>

      {% if form.password_needed %}
        <div class="field">
          <label class="field__label" for="CustomerPassword">{{ 'customers.login.password' | t }}</label>
          <input class="input" type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password" required>
        </div>
        <p><a href="#recover" data-recover-trigger>{{ 'customers.login.forgot_password' | t }}</a></p>
      {% endif %}

      <button type="submit" class="btn btn--primary btn--block">{{ 'customers.login.submit' | t }}</button>
    {% endform %}

    <p class="account-page__meta">
      New here? <a href="{{ routes.account_register_url }}">{{ 'customers.login.create_account' | t }}</a>
      · <a href="{{ routes.root_url }}">{{ 'customers.login.guest_continue' | t }}</a>
    </p>
  </div>

  <div class="account-page__narrow" id="recover" data-recover-panel hidden>
    <span class="route-label">ACCOUNT &rarr; RESET PASSWORD</span>
    <h1>{{ 'customers.recover_password.title' | t }}</h1>
    <p>{{ 'customers.recover_password.subtext' | t }}</p>

    {% form 'recover_customer_password' %}
      {% if form.errors %}
        <div class="form-status" data-state="error">{{ form.errors | default_errors }}</div>
      {% endif %}
      {% if form.posted_successfully? %}
        {% assign recover_posted = true %}
        <div class="form-status" data-state="success">{{ 'customers.recover_password.success' | t }}</div>
      {% endif %}

      <div class="field">
        <label class="field__label" for="RecoverEmail">{{ 'customers.login.email' | t }}</label>
        <input class="input" type="email" id="RecoverEmail" name="email" autocomplete="email" required>
      </div>

      <button type="submit" class="btn btn--primary btn--block">{{ 'customers.recover_password.submit' | t }}</button>
    {% endform %}

    <p class="account-page__meta">
      <a href="#login" data-login-trigger>&larr; {{ 'customers.login.title' | t }}</a>
    </p>
  </div>
</div>

<script>
  (function () {
    var login = document.getElementById('login');
    var recover = document.getElementById('recover');
    if (!login || !recover) return;

    function showRecover() {
      login.hidden = true;
      recover.hidden = false;
    }
    function showLogin() {
      recover.hidden = true;
      login.hidden = false;
    }

    document.querySelectorAll('[data-recover-trigger]').forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        showRecover();
      });
    });
    document.querySelectorAll('[data-login-trigger]').forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        showLogin();
      });
    });

    if (window.location.hash === '#recover' || {{ recover_posted | default: false | json }}) {
      showRecover();
    }
  })();
</script>

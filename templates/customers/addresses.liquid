<div class="container section account-page">
  <div class="account-page__header">
    <span class="route-label">ACCOUNT &rarr; ADDRESSES</span>
    <h1>{{ 'customers.addresses.title' | t }}</h1>
  </div>

  <div class="account-page__grid account-page__grid--2">
    {% for address in customer.addresses %}
      <div class="card account-page__card">
        <p>{{ address | format_address }}</p>
        <div class="account-page__meta" style="display:flex; gap: var(--space-3); margin-top: var(--space-3);">
          <a href="{{ routes.account_addresses_url }}/{{ address.id }}/edit" class="btn btn--sm btn--secondary">{{ 'customers.addresses.edit' | t }}</a>
          {% form 'customer_address', address, class: 'u-hidden' %}
            <button type="submit" name="_method" value="delete" class="btn btn--sm btn--ghost" data-address-delete>{{ 'customers.addresses.delete' | t }}</button>
          {% endform %}
        </div>
      </div>
    {% endfor %}
  </div>

  <details class="account-page__new-address">
    <summary class="btn btn--secondary">{{ 'customers.addresses.add_new' | t }}</summary>
    {% form 'customer_address', customer.new_address %}
      <div class="account-page__grid account-page__grid--2">
        <div class="field">
          <label class="field__label" for="AddressFirstName">First name</label>
          <input class="input" type="text" id="AddressFirstName" name="address[first_name]" value="{{ form.first_name }}">
        </div>
        <div class="field">
          <label class="field__label" for="AddressLastName">Last name</label>
          <input class="input" type="text" id="AddressLastName" name="address[last_name]" value="{{ form.last_name }}">
        </div>
      </div>
      <div class="field">
        <label class="field__label" for="AddressAddress1">Address</label>
        <input class="input" type="text" id="AddressAddress1" name="address[address1]" value="{{ form.address1 }}">
      </div>
      <div class="field">
        <label class="field__label" for="AddressAddress2">Apartment, suite, etc. (optional)</label>
        <input class="input" type="text" id="AddressAddress2" name="address[address2]" value="{{ form.address2 }}">
      </div>
      <div class="account-page__grid account-page__grid--2">
        <div class="field">
          <label class="field__label" for="AddressCity">City</label>
          <input class="input" type="text" id="AddressCity" name="address[city]" value="{{ form.city }}">
        </div>
        <div class="field">
          <label class="field__label" for="AddressZip">Postcode</label>
          <input class="input" type="text" id="AddressZip" name="address[zip]" value="{{ form.zip }}">
        </div>
      </div>
      <div class="field">
        <label class="field__label" for="AddressCountry">Country</label>
        <select class="input" id="AddressCountry" name="address[country]">{{ form.country_option_tags }}</select>
      </div>
      <div class="field">
        <label class="field__label" for="AddressPhone">Phone</label>
        <input class="input" type="tel" id="AddressPhone" name="address[phone]" value="{{ form.phone }}">
      </div>
      <button type="submit" class="btn btn--primary">Save address</button>
    {% endform %}
  </details>

  <p class="account-page__meta">
    <a href="{{ routes.account_url }}">&larr; {{ 'customers.account.title' | t }}</a>
  </p>
</div>

    "category-best-sellers": {
      "type": "featured-products",
      "settings": {
        "background": "white",
        "source": "current",
        "eyebrow": "MOST REORDERED",
        "heading": "Best sellers in this category",
        "product_count": 6,
        "show_cta": true,
        "cta_text": "See all best sellers",
        "cta_url": "/collections/best-sellers"
      }
    },
    "shop-by-need": {
      "type": "content-cards",
      "settings": {
        "background": "mist",
        "columns": "3",
        "eyebrow": "SHOP BY WHAT YOU NEED",
        "heading": "Narrow it down"
      },
      "blocks": {
        "n1": {
          "type": "card",
          "settings": {
            "label": "SMALL ORDERS",
            "heading": "Low MOQ",
            "body": "<p>The smallest minimums in the shop, for spreading a budget across several products.</p>",
            "link_text": "Shop low MOQ",
            "link_url": "/collections/low-moq"
          }
        },
        "n2": {
          "type": "card",
          "settings": {
            "label": "BUDGET",
            "heading": "Under £50",
            "body": "<p>Test a category without a big first order.</p>",
            "link_text": "Shop under £50",
            "link_url": "/collections/under-50"
          }
        },
        "n3": {
          "type": "card",
          "settings": {
            "label": "PLATFORM",
            "heading": "Best for Vinted",
            "body": "<p>Products suited to the UK fashion resale platform.</p>",
            "link_text": "Shop for Vinted",
            "link_url": "/collections/best-for-vinted"
          }
        },
        "n4": {
          "type": "card",
          "settings": {
            "label": "FIRST ORDER",
            "heading": "Starter Boxes",
            "body": "<p>A mixed box, so a first order tells you what your buyers actually want.</p>",
            "link_text": "Shop Starter Boxes",
            "link_url": "/collections/starter-boxes"
          }
        },
        "n5": {
          "type": "card",
          "settings": {
            "label": "MARGIN",
            "heading": "Higher margin",
            "body": "<p>A wider gap between trade price and typical UK retail. Results still depend on your listing and pricing.</p>",
            "link_text": "Shop higher margin",
            "link_url": "/collections/higher-margin"
          }
        },
        "n6": {
          "type": "card",
          "settings": {
            "label": "NO STOCK HOLDING",
            "heading": "Dropshipping",
            "body": "<p>Order a single unit once you have a buyer.</p>",
            "link_text": "Shop dropshipping",
            "link_url": "/collections/dropshipping"
          }
        }
      },
      "block_order": ["n1", "n2", "n3", "n4", "n5", "n6"]
    },
    "buying-guide": {
      "type": "numbered-steps",
      "settings": {
        "background": "white",
        "eyebrow": "BEFORE YOU BUY",
        "heading": "Three things worth knowing"
      },
      "blocks": {
        "g1": {
          "type": "step",
          "settings": {
            "text": "Check the sold listings, not the live ones. Search the item on eBay and filter to sold. If similar items shifted in the last month above your break-even, there is demand.",
            "link_text": "Read the Platform Guide",
            "link_url": "/pages/learn-platform-guide"
          }
        },
        "g2": {
          "type": "step",
          "settings": {
            "text": "Work out your floor before you list. Pack cost divided by units, plus packaging and platform fees. Never sell under that number.",
            "link_text": "Open the pricing calculator",
            "link_url": "/pages/faq#pricing-calculator"
          }
        },
        "g3": {
          "type": "step",
          "settings": {
            "text": "Buy one pack, not three. Sell it, count what you actually made, then decide. Buying deep on something untested is the most common way new resellers lose money.",
            "link_text": "Start with a Starter Box",
            "link_url": "/collections/starter-boxes"
          }
        }
      },
      "block_order": ["g1", "g2", "g3"]
    },
    "related": {
      "type": "collection-related",
      "settings": {
        "background": "paper",
        "eyebrow": "KEEP LOOKING",
        "heading": "Related collections"
      },
      "blocks": {
        "r1": { "type": "link", "settings": { "collection": "best-sellers", "label": "Best Sellers" } },
        "r2": { "type": "link", "settings": { "collection": "new-arrivals", "label": "New Arrivals" } },
        "r3": { "type": "link", "settings": { "collection": "starter-boxes", "label": "Starter Boxes" } },
        "r4": { "type": "link", "settings": { "collection": "under-50", "label": "Under £50" } },
        "r5": { "type": "link", "settings": { "collection": "dropshipping", "label": "Dropshipping" } },
        "r6": { "type": "link", "settings": { "collection": "selling-fast", "label": "Selling Fast" } }
      },
      "block_order": ["r1", "r2", "r3", "r4", "r5", "r6"]
    },
    "faq": {
      "type": "faq-accordion",
      "settings": {
        "background": "white",
        "group_by_category": false,
        "emit_schema": false,
        "eyebrow": "FAQ",
        "heading": "Before you order",
        "cta_text": "All questions",
        "cta_url": "/pages/faq"
      },
      "blocks": {
        "f1": {
          "type": "question",
          "settings": {
            "question": "What is the minimum I have to order?",
            "answer": "<p>It is set per product and shown on every product page and card. Anything tagged for dropshipping can be ordered as a single unit.</p>",
            "link_text": "See low MOQ products",
            "link_url": "/collections/low-moq"
          }
        },
        "f2": {
          "type": "question",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Everything ships from the UK.</p>",
            "dynamic_append": "dispatch_timeframe"
          }
        },
        "f3": {
          "type": "question",
          "settings": {
            "question": "Can I choose sizes, colours or designs?",
            "answer": "<p>Not on standard packs. Wholesale stock is sold as-is, and each product page states what is in the pack. Where a choice exists it appears as an option on the product itself.</p>"
          }
        },
        "f4": {
          "type": "question",
          "settings": {
            "question": "Where should I sell these?",
            "answer": "<p>It depends on the product. The Platform Guide breaks down what tends to move on Vinted, eBay, TikTok Shop and Facebook Marketplace.</p>",
            "link_text": "Read the Platform Guide",
            "link_url": "/pages/learn-platform-guide"
          }
        },
        "f5": {
          "type": "question",
          "settings": {
            "question": "What if something arrives damaged?",
            "answer": "<p>Tell us within 48 hours with photos and it is replaced or refunded in full.</p>",
            "link_text": "Full returns policy",
            "link_url": "/pages/returns-policy"
          }
        },
        "f6": {
          "type": "question",
          "settings": {
            "question": "Will I definitely make a profit?",
            "answer": "<p>No, and anyone telling you otherwise is selling you something. What you make depends on what you pay, how you list it, what you charge and demand on the day. We give you the stock and the guidance. The selling is still yours to do.</p>",
            "link_text": "Read the guides",
            "link_url": "/pages/learn"
          }
        }
      },
      "block_order": ["f1", "f2", "f3", "f4", "f5", "f6"]
    },
    "final-cta": {
      "type": "rich-text",
      "settings": {
        "background": "navy",
        "narrow": true,
        "heading": "Ready when you are.",
        "body": "<p>Not sure which pack suits you? Tell us your budget and where you plan to sell, and we will point you at something.</p>",
        "primary_label": "Shop this category",
        "primary_link_source": "custom",
        "primary_url": "#products",
        "secondary_label": "Need help choosing?",
        "secondary_link_source": "custom",
        "secondary_url": "/pages/contact"
      }
    }

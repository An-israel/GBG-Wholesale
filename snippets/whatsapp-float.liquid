{% doc %}
  Persistent, dismissible floating WhatsApp button. Pulls from the sitewide
  `whatsapp_link` setting everywhere - never hardcode the number/link.
{% enddoc %}

{%- if settings.whatsapp_link != blank -%}
  <div class="whatsapp-float" data-dismiss-key="whatsapp-float">
    <a
      class="whatsapp-float__link"
      href="{{ settings.whatsapp_link }}"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat with GBG on WhatsApp"
    >
      {% render 'icon', name: 'whatsapp' %}
      <span class="whatsapp-float__label">Chat with us</span>
    </a>
    <button
      type="button"
      class="whatsapp-float__dismiss"
      data-dismiss-trigger
      aria-label="{{ 'accessibility.whatsapp_dismiss' | t }}"
    >
      {% render 'icon', name: 'close' %}
    </button>
  </div>
{%- endif -%}

{% stylesheet %}
  .whatsapp-float {
    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 40;
    display: flex;
    align-items: center;
  }

  .whatsapp-float__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-whatsapp);
    color: #FFFFFF;
    text-decoration: none;
    padding: 0.85em 1.1em;
    border-radius: var(--radius);
    font-weight: 700;
    font-size: 0.9rem;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
    min-height: 44px;
  }

  .whatsapp-float__link svg {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }

  .whatsapp-float__label {
    display: none;
  }

  @media (min-width: 640px) {
    .whatsapp-float__label {
      display: inline;
    }
  }

  .whatsapp-float__dismiss {
    position: relative;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--color-ink);
    border: none;
    margin-left: -12px;
  }

  .whatsapp-float__dismiss::before {
    content: '';
    position: absolute;
    width: 20px;
    height: 20px;
    background: var(--color-ink);
    border: 2px solid var(--color-paper);
    border-radius: 50%;
  }

  .whatsapp-float__dismiss svg {
    position: relative;
    color: var(--color-paper);
    width: 12px;
    height: 12px;
  }
{% endstylesheet %}

{% doc %}
  Renders the store's actually-enabled payment method icons — pulled live from
  Shopify, never a hardcoded logo list that might claim to accept a method the
  store doesn't.
{% enddoc %}

{%- if shop.enabled_payment_types.size > 0 -%}
  <ul class="payment-icons">
    {%- for type in shop.enabled_payment_types -%}
      <li>{{ type | payment_type_svg_tag: class: 'payment-icons__icon' }}</li>
    {%- endfor -%}
  </ul>

  {% stylesheet %}
    .payment-icons {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .payment-icons__icon {
      height: 22px;
      width: auto;
    }
  {% endstylesheet %}
{%- endif -%}

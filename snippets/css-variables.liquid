{% style %}
  :root {
    --color-ink: {{ settings.color_ink }};
    --color-paper: {{ settings.color_paper }};
    --color-surface: {{ settings.color_surface }};
    --color-border: {{ settings.color_border }};
    --color-brass: {{ settings.color_brass }};
    --color-forest: {{ settings.color_forest }};
    --color-plum: {{ settings.color_plum }};
    --color-error: {{ settings.color_error }};

    /* WCAG-AA-safe derived shades: brass is too light to use as small text or
       white-on-brass buttons on light backgrounds, so it's darkened for those
       uses; forest/plum are dark enough for light backgrounds already but too
       dark to read on the ink background, so lightened variants exist for
       that context (applied automatically inside .section--ink). */
    --color-brass-text: color-mix(in srgb, var(--color-brass) 75%, black);
    --color-forest-on-dark: color-mix(in srgb, var(--color-forest) 55%, white);
    --color-plum-on-dark: color-mix(in srgb, var(--color-plum) 40%, white);

    --font-display: 'Space Grotesk', 'Arial Narrow', Helvetica, Arial, sans-serif;
    --font-body: 'Public Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    --font-editorial: 'Lora', Georgia, 'Times New Roman', serif;

    --page-width: {{ settings.page_width }}px;
    --radius: {{ settings.corner_radius }}px;

    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.5rem;
    --space-6: 2rem;
    --space-7: 3rem;
    --space-8: 4rem;
    --space-9: 6rem;

    color-scheme: light;
  }
{% endstyle %}

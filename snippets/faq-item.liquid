{% doc %}
  @param {object} block - a section block with settings: question, answer, link_text, link_url, image, image_alt

  @example
  {% render 'faq-item', block: block %}
{% enddoc %}

{%- liquid
  assign panel_id = 'FaqPanel-' | append: block.id
  assign trigger_id = 'FaqTrigger-' | append: block.id
-%}

<div class="accordion__item" {{ block.shopify_attributes }}>
  <h3>
    <button
      type="button"
      class="accordion__trigger"
      id="{{ trigger_id }}"
      aria-expanded="false"
      aria-controls="{{ panel_id }}"
      data-accordion-trigger
    >
      <span>{{ block.settings.question }}</span>
      <span class="accordion__icon">{% render 'icon', name: 'chevron' %}</span>
    </button>
  </h3>
  <div
    class="accordion__panel"
    id="{{ panel_id }}"
    role="region"
    aria-labelledby="{{ trigger_id }}"
    data-open="false"
  >
    <div class="accordion__panel-inner{% if block.settings.image %} accordion__panel-inner--with-image{% endif %}">
      <div class="accordion__answer">
      {{ block.settings.answer }}
      {% case block.settings.dynamic_append %}
        {% when 'warehouse_location' %}
          <p>{{ settings.warehouse_location }}</p>
        {% when 'dispatch_timeframe' %}
          <p>{{ settings.dispatch_timeframe }}</p>
        {% when 'starter_box_min_price' %}
          {%- capture from_pence -%}
            {%- render 'collection-min-price', handle: 'starter-boxes' -%}
          {%- endcapture -%}
          {%- assign from_pence = from_pence | plus: 0 -%}
          {%- if from_pence > 0 -%}
            <p>Starter Boxes begin at {{ from_pence | money }}.</p>
          {%- elsif settings.starter_box_min_price != blank -%}
            <p>Starter Boxes begin at £{{ settings.starter_box_min_price }}.</p>
          {%- endif -%}
        {% when 'next_live_date' %}
          <p>Next live session: {{ settings.next_live_date | default: 'announced inside the group' }}.</p>
      {% endcase %}
      {% if block.settings.link_text != blank and block.settings.link_url != blank %}
        <p><a href="{{ block.settings.link_url }}">{{ block.settings.link_text }} &rarr;</a></p>
      {% endif %}
      </div>
      {% if block.settings.image %}
        <img
          class="accordion__image"
          src="{{ block.settings.image | image_url: width: 600 }}"
          srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 600 }} 600w"
          sizes="(min-width: 800px) 260px, 100vw"
          alt="{{ block.settings.image_alt | default: block.settings.question | escape }}"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          loading="lazy"
        >
      {% endif %}
    </div>
  </div>
</div>

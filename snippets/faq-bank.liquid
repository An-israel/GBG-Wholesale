{% doc %}
  The FAQ bank: every question Lami wrote, held in one place and pulled by name.

  A question is written once here and appears wherever its set is asked for, so
  the answer on a category page, the product page and the main FAQ page can
  never drift apart. Nothing has to be typed into the theme editor and nothing
  is stored per page.

  Set "auto" picks the set from the collection being viewed, which is what lets
  one category template give nine categories nine different sets of questions.

  @param {string} set - a set name, or "auto" to choose from the collection
  @param {string} [mode] - "markup" (default) or "schema" for FAQPage JSON-LD
  @param {object} [collection] - required when set is "auto"

  @example
  {% render 'faq-bank', set: 'jewellery' %}
  {% render 'faq-bank', set: 'auto', collection: collection %}
{% enddoc %}

{%- liquid
  assign chosen = set | default: 'shopping'
  assign render_mode = mode | default: 'markup'

  if chosen == 'auto'
    assign chosen = 'shopping'

    assign jewellery_handles = 'jewellery-accessories,necklaces,earrings,bracelets,rings,jewellery-sets,jewellery-starter-box,mixed-branded-jewellery-box' | split: ','
    if jewellery_handles contains collection.handle
      assign chosen = 'jewellery'
    endif
    assign bags_handles = 'bags,fashion-bags,handbags,school-bags,wallets,travel-bags' | split: ','
    if bags_handles contains collection.handle
      assign chosen = 'bags'
    endif
    assign clothing_handles = 'clothing,womens-clothing,casualwear,knitwear,seasonal-clothing,mixed-clothing-packs,winter-essentials,summer-essentials' | split: ','
    if clothing_handles contains collection.handle
      assign chosen = 'clothing'
    endif
    assign beauty_handles = 'beauty-fragrance,perfumes,mini-perfumes,beauty-accessories,personal-care' | split: ','
    if beauty_handles contains collection.handle
      assign chosen = 'beauty'
    endif
    assign electronics_handles = 'electronics,fans,speakers,phone-accessories,small-electronics,home-gadgets' | split: ','
    if electronics_handles contains collection.handle
      assign chosen = 'electronics'
    endif
    assign home_handles = 'home-lifestyle,kitchenware,home-accessories,humidifiers,storage,lifestyle-products' | split: ','
    if home_handles contains collection.handle
      assign chosen = 'home'
    endif
    assign kids_handles = 'kids-school,school-shoes,kids-accessories,toys-games,feeding-sets,back-to-school' | split: ','
    if kids_handles contains collection.handle
      assign chosen = 'kids'
    endif
    assign drinkware_handles = 'drinkware,tumblers,cups,bottles,travel-cups' | split: ','
    if drinkware_handles contains collection.handle
      assign chosen = 'drinkware'
    endif
    assign starter_boxes_handles = 'starter-boxes,boutique-starter-box,mixed-product-starter-box' | split: ','
    if starter_boxes_handles contains collection.handle
      assign chosen = 'starter-boxes'
    endif
    assign dropshipping_handles = 'dropshipping' | split: ','
    if dropshipping_handles contains collection.handle
      assign chosen = 'dropshipping'
    endif
    assign vinted_handles = 'best-for-vinted' | split: ','
    if vinted_handles contains collection.handle
      assign chosen = 'vinted'
    endif
    assign ebay_handles = 'best-for-ebay' | split: ','
    if ebay_handles contains collection.handle
      assign chosen = 'ebay'
    endif
    assign tiktok_handles = 'best-for-tiktok-shop' | split: ','
    if tiktok_handles contains collection.handle
      assign chosen = 'tiktok'
    endif
    assign pricing_handles = 'under-50,under-100,low-cost-to-resell,higher-margin' | split: ','
    if pricing_handles contains collection.handle
      assign chosen = 'pricing'
    endif
    assign choosing_handles = 'low-moq,best-sellers,new-arrivals,trending-now,back-in-stock,selling-fast,deal-drops' | split: ','
    if choosing_handles contains collection.handle
      assign chosen = 'choosing'
    endif
  endif
-%}


{% doc %}
  "Order by DM" backup note. Editable per-product via the theme editor block
  on the product template, falling back to a sensible default.

  @param {product} product
  @param {string} [text]

  @example
  {% render 'dm-keyword-note', product: product %}
{% enddoc %}

{%- if settings.whatsapp_link != blank -%}
  <div class="dm-note">
    {% render 'icon', name: 'whatsapp' %}
    <p>
      {% if text != blank %}
        {{ text }}
      {% else %}
        {{ 'products.dm_keyword_default' | t }}
      {% endif %}
      Keyword: <strong>{{ product.handle | upcase | replace: '-', ' ' }}</strong>.
      <a href="{{ settings.whatsapp_link }}" target="_blank" rel="noopener noreferrer">Message us &rarr;</a>
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .dm-note {
    display: flex;
    gap: var(--space-3);
    background: color-mix(in srgb, var(--color-amber-text) 8%, var(--color-surface));
    border: 1px solid var(--color-amber-text);
    border-radius: var(--radius);
    padding: var(--space-4);
    margin-top: var(--space-4);
  }

  .dm-note svg {
    width: 20px;
    height: 20px;
    color: var(--color-amber-text);
    flex-shrink: 0;
  }

  .dm-note p {
    margin: 0;
    font-size: 0.85rem;
  }

  .dm-note a {
    color: var(--color-amber-text);
    font-weight: 700;
  }
{% endstylesheet %}

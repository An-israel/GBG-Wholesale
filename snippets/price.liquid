{% doc %}
  @param {product} product

  @example
  {% render 'price', product: product %}
{% enddoc %}

<span class="price">
  {% if product.price_varies %}
    <span class="price__varies">From</span>
  {% endif %}
  {% if product.compare_at_price > product.price %}
    <span class="price__sale">{{ product.price | money }}</span>
    <span class="price__compare">{{ product.compare_at_price | money }}</span>
  {% else %}
    <span class="price__regular">{{ product.price | money }}</span>
  {% endif %}
</span>

{% stylesheet %}
  .price {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-weight: 700;
    color: var(--color-brass-text);
  }

  .price__compare {
    text-decoration: line-through;
    color: color-mix(in srgb, var(--color-ink) 45%, transparent);
    font-weight: 400;
    font-size: 0.85em;
  }

  .price__varies {
    font-size: 0.75em;
    font-weight: 400;
    color: color-mix(in srgb, var(--color-ink) 55%, transparent);
  }
{% endstylesheet %}

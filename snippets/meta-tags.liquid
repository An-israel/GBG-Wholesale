<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="{{ settings.color_navy }}">

{%- if settings.favicon != blank -%}
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" sizes="32x32">
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 192, height: 192 }}" sizes="192x192">
  <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
{%- endif -%}

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
-%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- comment -%}
  A page with its own image uses it. Everything else falls back to the share
  image from Theme settings, so a link pasted into WhatsApp or TikTok is never
  a bare grey box.
{%- endcomment -%}
{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{%- elsif settings.share_image != blank -%}
  <meta property="og:image" content="https:{{ settings.share_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ settings.share_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: settings.share_image.aspect_ratio | round }}">
{%- elsif settings.logo != blank -%}
  <meta property="og:image" content="https:{{ settings.logo | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ settings.logo | image_url: width: 1200 }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- comment -%}
  Filtered, sorted and tag-narrowed listings are the same products in a
  different order. Left indexable they compete with the collection itself and
  dilute it, so they are marked noindex while still being followed.
{%- endcomment -%}
{%- if current_tags or request.page_type == 'search' or paginate.current_page > 1 -%}
  <meta name="robots" content="noindex,follow">
{%- endif -%}

{%- comment -%}
  Breadcrumbs, so search results show the path rather than a bare URL.
{%- endcomment -%}
{%- unless request.page_type == 'index' or request.page_type == 'password' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} }
        {%- if request.page_type == 'product' and collection -%}
          , { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ collection.url | prepend: shop.url | json }} }
          , { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ product.url | prepend: shop.url | json }} }
        {%- elsif request.page_type == 'product' -%}
          , { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ product.url | prepend: shop.url | json }} }
        {%- elsif request.page_type == 'collection' -%}
          , { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ collection.url | prepend: shop.url | json }} }
        {%- elsif request.page_type == 'page' -%}
          , { "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": {{ page.url | prepend: shop.url | json }} }
        {%- elsif request.page_type == 'article' -%}
          , { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ blog.url | prepend: shop.url | json }} }
          , { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ article.url | prepend: shop.url | json }} }
        {%- endif -%}
      ]
    }
  </script>
{%- endunless -%}

{%- if request.page_type == 'collection' and collection != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": {{ collection.title | json }},
      "description": {{ collection.description | strip_html | truncate: 300 | json }},
      "url": {{ collection.url | prepend: shop.url | json }},
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ collection.products_count }},
        "itemListElement": [
          {%- for item in collection.products limit: 12 -%}
            {%- unless forloop.first %},{% endunless -%}
            {
              "@type": "ListItem",
              "position": {{ forloop.index }},
              "url": {{ item.url | prepend: shop.url | json }},
              "name": {{ item.title | json }}
            }
          {%- endfor -%}
        ]
      }
    }
  </script>
{%- endif -%}

{%- comment -%}
  A WebSite / SearchAction block used to sit here. Dropped on purpose: Google
  retired the sitelinks searchbox rich result, so it earned nothing, and the
  braces its target URL template needs are rejected by Shopify's server-side
  Liquid parser. The Organization markup below is the part that still works.
{%- endcomment -%}
{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ settings.org_legal_name | default: shop.name | json }},
      "url": {{ shop.url | json }},
      "logo": {% if settings.logo %}{{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}{% else %}null{% endif %},
      "address": {
        "@type": "PostalAddress",
        "streetAddress": {{ settings.org_address_line | json }},
        "addressLocality": {{ settings.org_locality | json }},
        "postalCode": {{ settings.org_postal_code | json }},
        "addressCountry": {{ settings.org_country | default: 'GB' | json }}
      },
      "sameAs": [
        {% assign socials = '' %}
        {% if settings.social_instagram_url != blank %}{{ settings.social_instagram_url | json }}{% assign socials = 'y' %}{% endif %}
        {% if settings.social_facebook_url != blank %}{% if socials == 'y' %},{% endif %}{{ settings.social_facebook_url | json }}{% assign socials = 'y' %}{% endif %}
        {% if settings.social_tiktok_url != blank %}{% if socials == 'y' %},{% endif %}{{ settings.social_tiktok_url | json }}{% assign socials = 'y' %}{% endif %}
        {% if settings.social_pinterest_url != blank %}{% if socials == 'y' %},{% endif %}{{ settings.social_pinterest_url | json }}{% endif %}
      ]
    }
  </script>
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">

{%- liquid
  comment
    A title written by hand in the Search engine listing box is finished: Lami's
    category titles already end in the shop name, and appending it again pushes
    them past the length Google will show. So the shop name is only added to
    titles the theme generated itself.

    The check is on the metafield rather than on page_title, because comparing
    strings is case sensitive and "GBG Wholesale Hub" against a shop named
    "GBG wholesale" would not match.
  endcomment
  assign custom_title = collection.metafields.global.title_tag
    | default: page.metafields.global.title_tag
    | default: product.metafields.global.title_tag
    | default: article.metafields.global.title_tag
-%}
<title>
  {{ page_title }}
  {%- if current_tags %} - tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} - Page {{ current_page }}{% endif -%}
  {%- if custom_title == blank -%}
    {%- unless page_title contains shop.name %} - {{ shop.name }}{% endunless -%}
  {%- endif -%}
</title>

<link rel="canonical" href="{{ canonical_url }}">

{% if page_description %}
  <meta name="description" content="{{ page_description | escape }}">
{% endif %}

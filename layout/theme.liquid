<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-currency="{{ cart.currency.iso_code }}">
  <head>
    {% render 'css-variables' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    >

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {% render 'analytics' %}
  </head>

  {%- comment -%}
    A landing page is a page with one job and no way off it except the button.
    Menu, footer, cart, search and the floating WhatsApp button are all ways
    off it, so a template ending in .landing gets none of them.

    The page still lives on the shop, so it keeps the pixels, the fonts and the
    brand, and Lami still edits it in the theme editor like any other page.
  {%- endcomment -%}
  {%- liquid
    assign bare = false
    if template.suffix == 'landing' or template.suffix == 'thanks'
      assign bare = true
    endif
  -%}

  <body{% if bare %} class="is-landing"{% endif %}>
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% unless bare %}
      {% sections 'header-group' %}
    {% endunless %}

    <main id="MainContent">
      {{ content_for_layout }}
    </main>

    {% unless bare %}
      {% sections 'footer-group' %}

      {% section 'cart-drawer' %}
      {% render 'predictive-search' %}
      {% render 'waitlist-modal' %}
      {% render 'sypb-gate' %}
      {% if settings.show_whatsapp_float %}
        {% render 'whatsapp-float' %}
      {% endif %}
    {% endunless %}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'cart.js' | asset_url }}" defer></script>
  </body>
</html>

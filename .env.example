# ---------------------------------------------------------------------------
# GBG Wholesale Hub — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# Only NEXT_PUBLIC_* keys and the Stripe publishable key are ever exposed to
# the browser. The service role key is server-only (lib/supabase/admin.ts).
# ---------------------------------------------------------------------------

# Public site origin, e.g. https://gbgwholesale.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and anon (public) key — safe for the browser
# This project: https://lnhieoutyyisgjsuksol.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://lnhieoutyyisgjsuksol.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — SERVER ONLY. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Publishable key is public; secret + webhook secret are server only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend transactional email
RESEND_API_KEY=
EMAIL_FROM=GBG Wholesale <hello@gbgwholesale.com>
ADMIN_NOTIFICATION_EMAIL=

# Seed: the single super admin account granted on first run
SEED_SUPER_ADMIN_EMAIL=

# Shared secret for the on-demand /api/revalidate route
REVALIDATE_SECRET=

# Secret Vercel Cron sends as a Bearer token to the /api/cron/* routes.
# Set this in Vercel; the cron routes reject unauthorised calls in production.
CRON_SECRET=

# Rate limiting (optional — falls back to a Postgres-backed limiter if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (optional — public forms degrade gracefully if unset)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics — loaded only after cookie consent
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Fallback WhatsApp number (the live value lives in site_settings)
NEXT_PUBLIC_WHATSAPP_NUMBER=

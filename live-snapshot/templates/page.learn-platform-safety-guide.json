        },
        "s2": {
          "type": "step",
          "settings": {
            "text": "Read the notice properly and find the specific reason given. Appeals that don't address the stated reason get rejected."
          }
        },
        "s3": {
          "type": "step",
          "settings": {
            "text": "Gather your proof of purchase - supplier invoices and order confirmations showing the stock is legitimately yours to sell."
          }
        },
        "s4": {
          "type": "step",
          "settings": {
            "text": "Appeal once, calmly and factually. State what you sell, where you source it, and attach the evidence. Do not send several angry messages; it rarely helps and often hurts."
          }
        },
        "s5": {
          "type": "step",
          "settings": {
            "text": "Fulfil any orders you already owe. Leaving buyers stranded turns a temporary restriction into a permanent one."
          }
        },
        "s6": {
          "type": "step",

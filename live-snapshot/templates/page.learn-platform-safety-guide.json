        "background": "surface",
        "narrow": true,
        "eyebrow": "SAFE HABITS",
        "heading": "What a healthy reseller account looks like",
        "body": "<p>None of this is complicated. It's mostly pacing and honesty.</p>"
      },
      "blocks": {
        "h1": {
          "type": "list_item",
          "settings": {
            "text": "List steadily - a handful of items a day beats a hundred on Sunday night."
          }
        },
        "h2": {
          "type": "list_item",
          "settings": {
            "text": "Photograph every item yourself, in daylight, against a plain background."
          }
        },
        "h3": {
          "type": "list_item",
          "settings": {
            "text": "Write each listing fresh. Copy-pasted identical descriptions are easy to spot."
          }
        },
        "h4": {
          "type": "list_item",
          "settings": {
            "text": "Describe condition accurately, including flaws. A disclosed flaw almost never causes a dispute; an undisclosed one always does."
          }
        },
        "h5": {
          "type": "list_item",
          "settings": {
            "text": "Keep every conversation and payment inside the platform."
          }
        },
        "h6": {
          "type": "list_item",
          "settings": {
            "text": "Reply within 24 hours and dispatch within your stated window."
          }
        },
        "h7": {
          "type": "list_item",
          "settings": {
            "text": "Keep your receipts and order confirmations. If you're ever asked to prove your stock is legitimately sourced, you'll want them."
          }
        }
      },
      "block_order": [
        "h1",
        "h2",
        "h3",

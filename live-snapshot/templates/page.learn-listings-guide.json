        "heading": "A listing session that actually works"
      },
      "blocks": {
        "s1": {
          "type": "step",
          "settings": {
            "text": "Photograph everything in one daylight session - it's far faster than shooting item by item."
          }
        },
        "s2": {
          "type": "step",
          "settings": {
            "text": "Research titles in a batch: search each item, read the sold listings, note the repeated words."
          }
        },
        "s3": {
          "type": "step",
          "settings": {
            "text": "Write each listing individually. Copy-pasting the same description across twenty items is exactly the pattern that gets accounts flagged.",
            "link_text": "Read the Safety Guide",
            "link_source": "custom",
            "link_url": "/pages/learn-platform-safety-guide"
          }
        },
        "s4": {
          "type": "step",
          "settings": {
            "text": "Publish a few a day rather than all at once. Steady beats bulk, for the algorithm and for your sanity."
          }
        },
        "s5": {
          "type": "step",
          "settings": {
            "text": "After a week, check the stats and use the diagnosis table above to fix the ones that aren't moving."
          }
        },
        "s6": {
          "type": "step",
          "settings": {
            "text": "Reorder what sold through fastest, before you run out.",

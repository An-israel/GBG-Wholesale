<div class="container section account-page">
  <div class="account-page__narrow">
    <span class="route-label">ACCOUNT &rarr; CREATE</span>
    <h1>{{ 'customers.register.title' | t }}</h1>

    {% form 'create_customer' %}
      {% if form.errors %}
        <div class="form-status" data-state="error">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div class="account-page__grid account-page__grid--2">
        <div class="field">
          <label class="field__label" for="FirstName">{{ 'customers.register.first_name' | t }}</label>
          <input class="input" type="text" id="FirstName" name="customer[first_name]" autocomplete="given-name">
        </div>
        <div class="field">
          <label class="field__label" for="LastName">{{ 'customers.register.last_name' | t }}</label>
          <input class="input" type="text" id="LastName" name="customer[last_name]" autocomplete="family-name">
        </div>
      </div>

      <div class="field">
        <label class="field__label" for="RegisterEmail">{{ 'customers.register.email' | t }}</label>
        <input class="input" type="email" id="RegisterEmail" name="customer[email]" autocomplete="email" required>
      </div>

      <div class="field">
        <label class="field__label" for="RegisterPassword">{{ 'customers.register.password' | t }}</label>
        <input class="input" type="password" id="RegisterPassword" name="customer[password]" autocomplete="new-password" required>
      </div>

      <button type="submit" class="btn btn--primary btn--block">{{ 'customers.register.submit' | t }}</button>
    {% endform %}

    <p class="account-page__meta">
      Already have an account? <a href="{{ routes.account_login_url }}">{{ 'customers.login.title' | t }}</a>
    </p>
  </div>
</div>

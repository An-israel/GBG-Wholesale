<div class="container section account-page">
  <div class="account-page__narrow">
    <span class="route-label">ACCOUNT &rarr; ACTIVATE</span>
    <h1>Activate your account</h1>
    <p>Create a password to finish setting up your account.</p>

    {% form 'activate_customer_password' %}
      {% if form.errors %}
        <div class="form-status" data-state="error">{{ form.errors | default_errors }}</div>
      {% endif %}

      <div class="field">
        <label class="field__label" for="ActivatePassword">Password</label>
        <input class="input" type="password" id="ActivatePassword" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label class="field__label" for="ActivatePasswordConfirm">Confirm password</label>
        <input class="input" type="password" id="ActivatePasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>

      <button type="submit" class="btn btn--primary btn--block">Activate account</button>
    {% endform %}
  </div>
</div>

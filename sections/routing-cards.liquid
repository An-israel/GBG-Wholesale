<section id="{{ section.settings.custom_id | default: section.id }}" class="routing-cards section section--{{ section.settings.background }}">
  <div class="container">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <div class="section-intro reveal">
        {% if section.settings.eyebrow != blank %}<span class="route-label">{{ section.settings.eyebrow }}</span>{% endif %}
        {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
      </div>
    {% endif %}

    <div class="routing-cards__row" style="--card-count: {{ section.blocks.size }};">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link_url }}" class="routing-cards__card card reveal{% if block.settings.image %} routing-cards__card--has-image{% endif %}" {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            <img
              class="routing-cards__image"
              src="{{ block.settings.image | image_url: width: 700 }}"
              srcset="{{ block.settings.image | image_url: width: 450 }} 450w, {{ block.settings.image | image_url: width: 700 }} 700w"
              sizes="(min-width: 768px) 33vw, 100vw"
              alt="{{ block.settings.image_alt | default: block.settings.heading | escape }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
            >
          {% endif %}
          <span class="routing-cards__index" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3>{{ block.settings.heading }}</h3>
          {% if block.settings.body != blank %}<p>{{ block.settings.body }}</p>{% endif %}
          <span class="routing-cards__cta">
            {{ block.settings.link_text }}
            {% render 'icon', name: 'arrow-right' %}
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .routing-cards__row {
    display: grid;
    gap: var(--space-4);
    position: relative;
  }

  @media (min-width: 768px) {
    .routing-cards__row {
      grid-template-columns: repeat(var(--card-count, 4), 1fr);
      align-items: stretch;
    }
  }

  .routing-cards__card--has-image {
    padding-top: 0;
    overflow: hidden;
  }

  .routing-cards__image {
    width: calc(100% + (var(--space-5) * 2));
    margin-inline: calc(var(--space-5) * -1);
    margin-bottom: var(--space-4);
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .routing-cards__index {
    display: block;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--color-ink) 45%, transparent);
  }

  .routing-cards__card {
    padding: var(--space-5);
    text-decoration: none;
    color: var(--color-ink);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    border-top: 3px solid var(--color-accent);
    transition: transform 150ms ease, box-shadow 150ms ease;
  }

  .routing-cards__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
  }

  .routing-cards__card p {
    margin: 0;
    color: color-mix(in srgb, var(--color-ink) 75%, transparent);
    flex: 1;
  }

  .routing-cards__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    color: var(--color-accent);
    font-size: 0.9rem;
  }

  .routing-cards__cta svg {
    width: 14px;
    height: 14px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Routing cards",
  "settings": [
    { "type": "text", "id": "custom_id", "label": "Anchor ID (optional)" },
    { "type": "select", "id": "background", "label": "Section background", "info": "Vary this down a page so each band reads as its own.", "options": [
        { "value": "paper", "label": "Paper (light grey)" },
        { "value": "white", "label": "White" },
        { "value": "mist", "label": "Mist (pale navy)" },
        { "value": "amber", "label": "Amber tint" },
        { "value": "aqua", "label": "Aqua tint" },
        { "value": "navy", "label": "Navy (dark)" }
      ], "default": "aqua" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow / route label" },
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (optional)", "info": "Sits across the top of the card." },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "New to reselling?" },
        { "type": "textarea", "id": "body", "label": "Body" },
        { "type": "text", "id": "link_text", "label": "Link text", "default": "Start Here" },
        { "type": "url", "id": "link_url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Routing cards",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}

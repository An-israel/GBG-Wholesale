<section id="{{ section.settings.custom_id | default: section.id }}" class="numbered-steps section section--{{ section.settings.background }}">
  <div class="container">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <div class="section-intro reveal">
        {% if section.settings.eyebrow != blank %}<span class="route-label">{{ section.settings.eyebrow }}</span>{% endif %}
        {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
      </div>
    {% endif %}

    <ol class="numbered-steps__list">
      {% for block in section.blocks %}
        <li class="numbered-steps__item reveal" {{ block.shopify_attributes }}>
          <span class="numbered-steps__number" aria-hidden="true">{{ forloop.index }}</span>
          <div class="numbered-steps__body">
            <p>{{ block.settings.text }}</p>
            {% liquid
              assign step_href = block.settings.link_url
              if block.settings.link_source == 'sypb_link'
                assign step_href = settings.sypb_link
              elsif block.settings.link_source == 'sypb_video'
                assign step_href = settings.sypb_video_url | default: settings.sypb_link
              elsif block.settings.link_source == 'whatsapp_link'
                assign step_href = settings.whatsapp_link
              elsif block.settings.link_source == 'wholesale_hub_link'
                assign step_href = settings.wholesale_hub_join_link
              endif
            %}
            {% if block.settings.link_text != blank and step_href != blank %}
              <a href="{{ step_href }}" class="numbered-steps__link" {% if block.settings.link_source == 'sypb_video' %}data-sypb-trigger{% endif %} {% if block.settings.link_source != 'custom' %}target="_blank" rel="noopener noreferrer"{% endif %}>
                {{ block.settings.link_text }}
                {% render 'icon', name: 'arrow-right' %}
              </a>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ol>
  </div>
</section>

{% stylesheet %}
  .numbered-steps__list {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
    display: grid;
    gap: 0;
  }

  .numbered-steps__item {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .numbered-steps__item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .numbered-steps__number {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--color-accent);
  }

  .numbered-steps__body p {
    margin: 0;
    font-size: 1.05rem;
  }

  .numbered-steps__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .numbered-steps__link svg {
    width: 14px;
    height: 14px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Numbered steps",
  "settings": [
    { "type": "text", "id": "custom_id", "label": "Anchor ID (optional)" },
    { "type": "select", "id": "background", "label": "Section background", "info": "Vary this down a page so each band reads as its own.", "options": [
        { "value": "paper", "label": "Paper (light grey)" },
        { "value": "white", "label": "White" },
        { "value": "mist", "label": "Mist (pale navy)" },
        { "value": "amber", "label": "Amber tint" },
        { "value": "aqua", "label": "Aqua tint" },
        { "value": "navy", "label": "Navy (dark)" }
      ], "default": "mist" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow / route label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How It Works" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Step text", "default": "Choose your pack" },
        { "type": "text", "id": "link_text", "label": "Optional link text" },
        { "type": "select", "id": "link_source", "label": "Optional link target", "options": [
            { "value": "custom", "label": "Custom link (set below)" },
            { "value": "sypb_link", "label": "Sitewide SYPB link" },
            { "value": "sypb_video", "label": "Sitewide SYPB video link" },
            { "value": "whatsapp_link", "label": "Sitewide WhatsApp link" },
            { "value": "wholesale_hub_link", "label": "Sitewide Wholesale Hub link" }
          ], "default": "custom" },
        { "type": "url", "id": "link_url", "label": "Optional custom link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Numbered steps",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}

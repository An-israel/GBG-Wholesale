<div class="cart-drawer" id="CartDrawer" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" hidden>
  <div class="cart-drawer__backdrop" data-cart-close></div>
  <div class="cart-drawer__panel">
    <div class="cart-drawer__header">
      <h2 id="CartDrawerTitle">{{ 'cart.title' | t }}</h2>
      <button type="button" class="site-header__icon-btn" data-cart-close aria-label="{{ 'accessibility.close_cart' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </div>

    {% if cart.item_count == 0 %}
      <div class="cart-drawer__empty">
        <p>{{ 'cart.empty' | t }}</p>
        <p class="field__hint">{{ 'cart.empty_body' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary" data-cart-close>{{ 'cart.continue_shopping' | t }}</a>
      </div>
    {% else %}
      <ul class="cart-drawer__items">
        {% for item in cart.items %}
          <li class="cart-drawer__item" data-cart-line="{{ forloop.index }}">
            <a href="{{ item.url }}" class="cart-drawer__item-image">
              {% if item.image %}
                <img
                  src="{{ item.image | image_url: width: 200 }}"
                  alt="{{ item.image.alt | default: item.title | escape }}"
                  width="100"
                  height="{{ 100 | divided_by: item.image.aspect_ratio | default: 100 }}"
                  loading="lazy"
                >
              {% endif %}
            </a>
            <div class="cart-drawer__item-details">
              <a href="{{ item.url }}" class="cart-drawer__item-title">{{ item.product.title }}</a>
              {% unless item.variant.title == 'Default Title' %}
                <p class="cart-drawer__item-variant">{{ item.variant.title }}</p>
              {% endunless %}
              <p class="cart-drawer__item-price">{{ item.final_line_price | money }}</p>

              <div class="cart-drawer__item-controls">
                <div class="qty-stepper">
                  <button type="button" class="qty-stepper__btn" data-cart-qty-decrease data-line="{{ forloop.index }}" aria-label="Decrease quantity">
                    {% render 'icon', name: 'minus' %}
                  </button>
                  <input
                    class="qty-stepper__input"
                    type="number"
                    min="0"
                    value="{{ item.quantity }}"
                    data-cart-qty-input
                    data-line="{{ forloop.index }}"
                    aria-label="{{ 'cart.quantity' | t }}"
                  >
                  <button type="button" class="qty-stepper__btn" data-cart-qty-increase data-line="{{ forloop.index }}" aria-label="Increase quantity">
                    {% render 'icon', name: 'plus' %}
                  </button>
                </div>
                <button type="button" class="cart-drawer__remove" data-cart-remove data-line="{{ forloop.index }}">
                  {% render 'icon', name: 'trash' %}
                  <span class="visually-hidden">{{ 'cart.remove' | t }}</span>
                </button>
              </div>
            </div>
          </li>
        {% endfor %}
      </ul>

      <div class="cart-drawer__footer">
        <div class="cart-drawer__subtotal">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="field__hint">{{ settings.dispatch_timeframe }}</p>
        <p class="field__hint">Shipping, taxes and discount codes are calculated at checkout.</p>
        <a href="{{ routes.cart_url }}" class="btn btn--secondary btn--block">{{ 'cart.view_full_cart' | t }}</a>
        <a href="{{ routes.cart_url }}/checkout" class="btn btn--primary btn--block">{{ 'cart.checkout' | t }}</a>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .cart-drawer {
    position: fixed;
    inset: 0;
    z-index: 90;
  }

  .cart-drawer[hidden] {
    display: none;
  }

  .cart-drawer__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(22, 24, 29, 0.5);
  }

  .cart-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: min(420px, 92vw);
    background: var(--color-paper);
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    overflow-y: auto;
  }

  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-5);
  }

  .cart-drawer__empty {
    text-align: center;
    padding-block: var(--space-7);
  }

  .cart-drawer__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    flex: 1;
  }

  .cart-drawer__item {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: var(--space-4);
  }

  .cart-drawer__item-image {
    display: block;
    background: var(--color-surface);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .cart-drawer__item-title {
    font-weight: 700;
    text-decoration: none;
    color: var(--color-ink);
    display: block;
  }

  .cart-drawer__item-variant {
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--color-ink) 65%, transparent);
    margin: var(--space-1) 0;
  }

  .cart-drawer__item-price {
    font-weight: 700;
    color: var(--color-accent);
    margin: var(--space-2) 0;
  }

  .cart-drawer__item-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .qty-stepper {
    display: inline-flex;
    align-items: center;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius);
  }

  .qty-stepper__btn {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
  }

  .qty-stepper__btn svg {
    width: 14px;
    height: 14px;
  }

  .qty-stepper__input {
    width: 36px;
    text-align: center;
    border: none;
    background: none;
    font-size: 0.9rem;
 -moz-appearance: textfield;
  }

  .cart-drawer__remove {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--color-error);
  }

  .cart-drawer__remove svg {
    width: 18px;
    height: 18px;
  }

  .cart-drawer__footer {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-5);
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-3);
  }

  .cart-drawer__subtotal {
    display: flex;
    justify-content: space-between;
    font-weight: 700;
    font-size: 1.1rem;
  }
{% endstylesheet %}

{%- comment -%}
  Every review on the shop, on one page.

  Same arrangement as the carousel: Judge.me renders its own widget from its
  own app block. This section is the frame around the slot.
{%- endcomment -%}

{%- liquid
  assign app_blocks = 0
  for block in section.blocks
    if block.type == '@app'
      assign app_blocks = app_blocks | plus: 1
    endif
  endfor
-%}

<section
  id="{{ section.settings.custom_id | default: section.id }}"
  class="reviews-all section section--{{ section.settings.background }}"
>
  <div class="container">
    {% if app_blocks > 0 %}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {%- render block -%}
        {%- endcase -%}
      {%- endfor -%}
    {% elsif request.design_mode %}
      <div class="reviews-all__setup">
        <p><strong>No reviews widget added yet.</strong></p>
        <p>
          Click <em>Add block</em>, choose <em>Judge.me</em>, and pick the
          All Reviews widget. Judge.me renders the reviews here itself.
        </p>
        <p>
          If the block is there and still shows nothing, check that Judge.me is
          switched on under <em>Theme settings &rsaquo; App embeds</em>, and
          that at least one review has been published.
        </p>
      </div>
    {% else %}
      <p class="reviews-all__empty">
        No reviews published yet. The screenshots from the group are on the
        <a href="{{ routes.root_url }}">home page</a> in the meantime.
      </p>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  /* Only ever seen inside the theme editor. */
  .reviews-all__setup {
    border: 1px dashed color-mix(in srgb, var(--color-navy) 35%, transparent);
    border-radius: var(--radius);
    background: var(--color-surface);
    padding: var(--space-5);
    font-size: 0.9rem;
    max-width: 46rem;
    margin-inline: auto;
  }

  .reviews-all__setup p:last-child {
    margin-bottom: 0;
  }

  .reviews-all__empty {
    text-align: center;
    color: var(--color-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "All reviews",
  "settings": [
    { "type": "paragraph", "content": "Add the Judge.me All Reviews widget as a block below. Judge.me renders the reviews itself." },
    { "type": "text", "id": "custom_id", "label": "Anchor ID (optional)" },
    { "type": "select", "id": "background", "label": "Section background", "options": [
        { "value": "paper", "label": "Paper (light grey)" },
        { "value": "white", "label": "White" },
        { "value": "mist", "label": "Mist (pale navy)" },
        { "value": "amber", "label": "Amber tint" },
        { "value": "aqua", "label": "Aqua tint" },
        { "value": "navy", "label": "Navy (dark)" }
      ], "default": "white" }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "All reviews" }]
}
{% endschema %}

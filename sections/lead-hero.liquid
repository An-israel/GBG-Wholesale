{%- comment -%}
  Landing page hero.

  One job: say what this is and send people to the form. The only link on the
  page is the button, because every other link is a way of leaving.
{%- endcomment -%}

<section class="lead-hero section section--{{ section.settings.background }}">
  <div class="container lead-hero__inner">
    {% if section.settings.show_logo %}
      <div class="lead-hero__brand">{% render 'brand-lockup' %}</div>
    {% endif %}

    <h1 class="lead-hero__title">{{ section.settings.heading }}</h1>

    {% if section.settings.body != blank %}
      <div class="lead-hero__body">{{ section.settings.body }}</div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <ul class="lead-hero__list">
        {% for block in section.blocks %}
          <li {{ block.shopify_attributes }}>
            {% render 'icon', name: 'check' %}<span>{{ block.settings.text }}</span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    <div class="lead-hero__actions">
      <a href="#{{ section.settings.target }}" class="btn btn--primary btn--lg">
        {{ section.settings.cta_label }}
      </a>
      {% if section.settings.note != blank %}
        <p class="lead-hero__note">{{ section.settings.note }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .lead-hero__inner {
    max-width: 44rem;
    padding-block: var(--space-7);
  }

  .lead-hero__brand {
    margin-bottom: var(--space-6);
  }

  .lead-hero__title {
    font-size: clamp(1.9rem, 1.2rem + 3vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.05;
    text-wrap: balance;
    margin-bottom: var(--space-5);
  }

  .lead-hero__body {
    font-size: 1.05rem;
    max-width: 38rem;
  }

  .lead-hero__list {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .lead-hero__list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: 0.98rem;
  }

  .lead-hero__list svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 0.3em;
    color: var(--color-accent);
  }

  .lead-hero__actions {
    margin-top: var(--space-6);
  }

  .lead-hero__note {
    font-size: 0.86rem;
    color: var(--color-muted);
    margin: var(--space-3) 0 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Landing hero",
  "settings": [
    { "type": "select", "id": "background", "label": "Section background", "options": [
        { "value": "white", "label": "White" },
        { "value": "paper", "label": "Paper (light grey)" },
        { "value": "mist", "label": "Mist (pale navy)" },
        { "value": "amber", "label": "Amber tint" },
        { "value": "navy", "label": "Navy (dark)" }
      ], "default": "white" },
    { "type": "checkbox", "id": "show_logo", "label": "Show the logo", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find products to start or grow your reseller business" },
    { "type": "richtext", "id": "body", "label": "Intro" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Start the questionnaire" },
    { "type": "text", "id": "target", "label": "Button jumps to", "info": "The anchor ID of the questionnaire section.", "default": "questionnaire" },
    { "type": "text", "id": "note", "label": "Line under the button", "default": "It takes about two minutes." }
  ],
  "blocks": [
    { "type": "point", "name": "Bullet", "settings": [
        { "type": "text", "id": "text", "label": "Text" }
      ] }
  ],
  "presets": [{ "name": "Landing hero", "blocks": [{ "type": "point" }, { "type": "point" }, { "type": "point" }] }]
}
{% endschema %}

{%- comment -%}
  The reseller questionnaire.

  Eleven questions, shown one at a time by assets/lead-form.js. The markup is
  a plain form with every question present, so with JavaScript off it is still
  a working form rather than a blank panel: the script hides the steps, not
  the other way round.

  Answers go to Omnisend through its own script. Nothing of ours receives
  them, so there is no server to keep running and no database to look after.
  Omnisend has to be switched on under Theme settings, App embeds.

  Name, email and number are sent the moment they are given, tagged
  lead-partial. Somebody who answers three questions and wanders off is still
  a lead worth following up, and waiting for a perfect submission loses them.
{%- endcomment -%}

{%- liquid
  assign thanks = section.settings.thanks_url | default: '/pages/thank-you'
-%}

<section
  id="{{ section.settings.custom_id | default: section.id }}"
  class="lead-section section section--{{ section.settings.background }}"
>
  <div class="container lead-section__inner">
    <div class="section-intro">
      {% if section.settings.eyebrow != blank %}
        <span class="route-label route-label--amber">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.body != blank %}<p>{{ section.settings.body }}</p>{% endif %}
    </div>

    <form class="lead-form" data-lead-form data-thanks-url="{{ thanks }}" novalidate>
      <div class="lead-form__progress" aria-hidden="true">
        <div class="lead-form__bar" data-progress-bar></div>
      </div>
      <p class="lead-form__count" data-progress-count aria-live="polite"></p>

      <div class="lead-form__step" data-step data-required="true" hidden>
        <div class="lead-form__field">
          <label class="lead-form__label" for="Lead-firstName">What is your name?</label>
          <input type="text" id="Lead-firstName" name="firstName" class="input" placeholder="First name" autocomplete="given-name" required>
        </div>
      </div>

      <div class="lead-form__step" data-step data-required="true" hidden>
        <div class="lead-form__field">
          <label class="lead-form__label" for="Lead-email">What is your email address?</label>
          <input type="email" id="Lead-email" name="email" class="input" placeholder="you@example.com" autocomplete="email" required>
        </div>
      </div>

      <div class="lead-form__step" data-step data-required="true" hidden>
        <div class="lead-form__field">
          <label class="lead-form__label" for="Lead-phone">What is your WhatsApp number?</label>
          <input type="tel" id="Lead-phone" name="phone" class="input" placeholder="07123 456789" autocomplete="tel" required>
        </div>
      </div>

      <div class="lead-form__step" data-step data-required="true" hidden>
        <div class="lead-form__field">
          <label class="lead-form__label" for="Lead-city">Where are you based?</label>
          <input type="text" id="Lead-city" name="city" class="input" placeholder="City or town" autocomplete="address-level2" required>
        </div>
      </div>

      <div class="lead-form__step" data-step data-required="true" hidden>
        <fieldset class="lead-form__field">
          <legend class="lead-form__label">Which best describes you right now?</legend>
          <div class="lead-form__choices lead-form__choices--radio">
            <label class="lead-choice" for="Lead-stage-0">
              <input type="radio" id="Lead-stage-0" name="stage" value="I haven't started a business yet">
              <span>I haven't started a business yet</span>
            </label>
            <label class="lead-choice" for="Lead-stage-1">
              <input type="radio" id="Lead-stage-1" name="stage" value="I'm researching what business to start">
              <span>I'm researching what business to start</span>
            </label>
            <label class="lead-choice" for="Lead-stage-2">
              <input type="radio" id="Lead-stage-2" name="stage" value="I've started selling but sales are still inconsistent">
              <span>I've started selling but sales are still inconsistent</span>
            </label>
            <label class="lead-choice" for="Lead-stage-3">
              <input type="radio" id="Lead-stage-3" name="stage" value="I already sell products regularly">
              <span>I already sell products regularly</span>
            </label>
            <label class="lead-choice" for="Lead-stage-4">
              <input type="radio" id="Lead-stage-4" name="stage" value="I run an established product-based business">
              <span>I run an established product-based business</span>
            </label>
            <label class="lead-choice" for="Lead-stage-5">
              <input type="radio" id="Lead-stage-5" name="stage" value="I currently buy wholesale stock for resale">
              <span>I currently buy wholesale stock for resale</span>
            </label>
          </div>
        </fieldset>
      </div>

      <div class="lead-form__step" data-step data-required="true" hidden>
        <fieldset class="lead-form__field">
          <legend class="lead-form__label">Where are you currently selling, or where do you plan to sell?</legend>
          <p class="lead-form__hint">Select all that apply.</p>
          <div class="lead-form__choices lead-form__choices--checkbox">
            <label class="lead-choice" for="Lead-platforms-0">
              <input type="checkbox" id="Lead-platforms-0" name="platforms[]" value="TikTok Shop">
              <span>TikTok Shop</span>
            </label>
            <label class="lead-choice" for="Lead-platforms-1">
              <input type="checkbox" id="Lead-platforms-1" name="platforms[]" value="Vinted">
              <span>Vinted</span>
            </label>
            <label class="lead-choice" for="Lead-platforms-2">
              <input type="checkbox" id="Lead-platforms-2" name="platforms[]" value="eBay">
              <span>eBay</span>
            </label>
            <label class="lead-choice" for="Lead-platforms-3">
              <input type="checkbox" id="Lead-platforms-3" name="platforms[]" value="Facebook Marketplace">
              <span>Facebook Marketplace</span>
            </label>
            <label class="lead-choice" for="Lead-platforms-4">
              <input type="checkbox" id="Lead-platforms-4" name="platforms[]" value="Instagram">
              <span>Instagram</span>
            </label>
            <label class="lead-choice" for="Lead-platforms-5">
              <input type="checkbox" id="Lead-platforms-5" name="platforms[]" value="WhatsApp">
              <span>WhatsApp</span>
            </label>
            <label class="lead-choice" for="Lead-platforms-6">
              <input type="checkbox" id="Lead-platforms-6" name="platforms[]" value="My own website">
              <span>My own website</span>
            </label>
            <label class="lead-choice" for="Lead-platforms-7">
              <input type="checkbox" id="Lead-platforms-7" name="platforms[]" value="Physical shop or market">
              <span>Physical shop or market</span>
            </label>
            <label class="lead-choice" for="Lead-platforms-8">
              <input type="checkbox" id="Lead-platforms-8" name="platforms[]" value="I haven't started selling yet">
              <span>I haven't started selling yet</span>
            </label>
            <label class="lead-choice" for="Lead-platforms-9">
              <input type="checkbox" id="Lead-platforms-9" name="platforms[]" value="Other">
              <span>Other</span>
            </label>
          </div>
        </fieldset>
      </div>

      <div class="lead-form__step" data-step data-required="true" hidden>
        <fieldset class="lead-form__field">
          <legend class="lead-form__label">What type of products are you most interested in selling?</legend>
          <p class="lead-form__hint">Select all that apply.</p>
          <div class="lead-form__choices lead-form__choices--checkbox">
            <label class="lead-choice" for="Lead-categories-0">
              <input type="checkbox" id="Lead-categories-0" name="categories[]" value="Fashion &amp; clothing">
              <span>Fashion &amp; clothing</span>
            </label>
            <label class="lead-choice" for="Lead-categories-1">
              <input type="checkbox" id="Lead-categories-1" name="categories[]" value="Bags &amp; accessories">
              <span>Bags &amp; accessories</span>
            </label>
            <label class="lead-choice" for="Lead-categories-2">
              <input type="checkbox" id="Lead-categories-2" name="categories[]" value="Jewellery">
              <span>Jewellery</span>
            </label>
            <label class="lead-choice" for="Lead-categories-3">
              <input type="checkbox" id="Lead-categories-3" name="categories[]" value="Beauty products">
              <span>Beauty products</span>
            </label>
            <label class="lead-choice" for="Lead-categories-4">
              <input type="checkbox" id="Lead-categories-4" name="categories[]" value="Hair products">
              <span>Hair products</span>
            </label>
            <label class="lead-choice" for="Lead-categories-5">
              <input type="checkbox" id="Lead-categories-5" name="categories[]" value="Home &amp; kitchen products">
              <span>Home &amp; kitchen products</span>
            </label>
            <label class="lead-choice" for="Lead-categories-6">
              <input type="checkbox" id="Lead-categories-6" name="categories[]" value="Electronics &amp; gadgets">
              <span>Electronics &amp; gadgets</span>
            </label>
            <label class="lead-choice" for="Lead-categories-7">
              <input type="checkbox" id="Lead-categories-7" name="categories[]" value="Baby &amp; children's products">
              <span>Baby &amp; children's products</span>
            </label>
            <label class="lead-choice" for="Lead-categories-8">
              <input type="checkbox" id="Lead-categories-8" name="categories[]" value="Seasonal or trending products">
              <span>Seasonal or trending products</span>
            </label>
            <label class="lead-choice" for="Lead-categories-9">
              <input type="checkbox" id="Lead-categories-9" name="categories[]" value="Mixed reseller boxes">
              <span>Mixed reseller boxes</span>
            </label>
            <label class="lead-choice" for="Lead-categories-10">
              <input type="checkbox" id="Lead-categories-10" name="categories[]" value="Clearance or overstock products">
              <span>Clearance or overstock products</span>
            </label>
            <label class="lead-choice" for="Lead-categories-11">
              <input type="checkbox" id="Lead-categories-11" name="categories[]" value="Branded stock">
              <span>Branded stock</span>
            </label>
            <label class="lead-choice" for="Lead-categories-12">
              <input type="checkbox" id="Lead-categories-12" name="categories[]" value="I'm not sure yet, I need help choosing">
              <span>I'm not sure yet, I need help choosing</span>
            </label>
          </div>
        </fieldset>
      </div>

      <div class="lead-form__step" data-step data-required="true" hidden>
        <fieldset class="lead-form__field">
          <legend class="lead-form__label">How much are you currently comfortable investing in stock?</legend>
          <div class="lead-form__choices lead-form__choices--radio">
            <label class="lead-choice" for="Lead-budget-0">
              <input type="radio" id="Lead-budget-0" name="budget" value="Under £100">
              <span>Under £100</span>
            </label>
            <label class="lead-choice" for="Lead-budget-1">
              <input type="radio" id="Lead-budget-1" name="budget" value="£100 to £250">
              <span>£100 to £250</span>
            </label>
            <label class="lead-choice" for="Lead-budget-2">
              <input type="radio" id="Lead-budget-2" name="budget" value="£250 to £500">
              <span>£250 to £500</span>
            </label>
            <label class="lead-choice" for="Lead-budget-3">
              <input type="radio" id="Lead-budget-3" name="budget" value="£500 to £1,000">
              <span>£500 to £1,000</span>
            </label>
            <label class="lead-choice" for="Lead-budget-4">
              <input type="radio" id="Lead-budget-4" name="budget" value="£1,000 to £2,500">
              <span>£1,000 to £2,500</span>
            </label>
            <label class="lead-choice" for="Lead-budget-5">
              <input type="radio" id="Lead-budget-5" name="budget" value="£2,500 or more">
              <span>£2,500 or more</span>
            </label>
            <label class="lead-choice" for="Lead-budget-6">
              <input type="radio" id="Lead-budget-6" name="budget" value="I'm not ready to invest yet">
              <span>I'm not ready to invest yet</span>
            </label>
          </div>
        </fieldset>
      </div>

      <div class="lead-form__step" data-step data-required="true" hidden>
        <fieldset class="lead-form__field">
          <legend class="lead-form__label">What do you need the most help with right now?</legend>
          <div class="lead-form__choices lead-form__choices--radio">
            <label class="lead-choice" for="Lead-need-0">
              <input type="radio" id="Lead-need-0" name="need" value="I want to buy stock and start selling immediately">
              <span>I want to buy stock and start selling immediately</span>
            </label>
            <label class="lead-choice" for="Lead-need-1">
              <input type="radio" id="Lead-need-1" name="need" value="I'm already selling and need new products">
              <span>I'm already selling and need new products</span>
            </label>
            <label class="lead-choice" for="Lead-need-2">
              <input type="radio" id="Lead-need-2" name="need" value="I need help choosing profitable products">
              <span>I need help choosing profitable products</span>
            </label>
            <label class="lead-choice" for="Lead-need-3">
              <input type="radio" id="Lead-need-3" name="need" value="I want to learn how to start first">
              <span>I want to learn how to start first</span>
            </label>
            <label class="lead-choice" for="Lead-need-4">
              <input type="radio" id="Lead-need-4" name="need" value="I need help growing my existing business">
              <span>I need help growing my existing business</span>
            </label>
            <label class="lead-choice" for="Lead-need-5">
              <input type="radio" id="Lead-need-5" name="need" value="I'm interested in larger wholesale or bulk-buying opportunities">
              <span>I'm interested in larger wholesale or bulk-buying opportunities</span>
            </label>
            <label class="lead-choice" for="Lead-need-6">
              <input type="radio" id="Lead-need-6" name="need" value="I'm still exploring my options">
              <span>I'm still exploring my options</span>
            </label>
          </div>
        </fieldset>
      </div>

      <div class="lead-form__step" data-step data-required="true" hidden>
        <fieldset class="lead-form__field">
          <legend class="lead-form__label">How soon are you looking to take action?</legend>
          <div class="lead-form__choices lead-form__choices--radio">
            <label class="lead-choice" for="Lead-timeline-0">
              <input type="radio" id="Lead-timeline-0" name="timeline" value="I'm ready now">
              <span>I'm ready now</span>
            </label>
            <label class="lead-choice" for="Lead-timeline-1">
              <input type="radio" id="Lead-timeline-1" name="timeline" value="Within the next 30 days">
              <span>Within the next 30 days</span>
            </label>
            <label class="lead-choice" for="Lead-timeline-2">
              <input type="radio" id="Lead-timeline-2" name="timeline" value="Within 1 to 3 months">
              <span>Within 1 to 3 months</span>
            </label>
            <label class="lead-choice" for="Lead-timeline-3">
              <input type="radio" id="Lead-timeline-3" name="timeline" value="Within 3 to 6 months">
              <span>Within 3 to 6 months</span>
            </label>
            <label class="lead-choice" for="Lead-timeline-4">
              <input type="radio" id="Lead-timeline-4" name="timeline" value="I'm still researching">
              <span>I'm still researching</span>
            </label>
          </div>
        </fieldset>
      </div>

      <div class="lead-form__step" data-step data-required="false" hidden>
        <div class="lead-form__field">
          <label class="lead-form__label" for="Lead-challenge">What is your biggest challenge right now?</label>
          <p class="lead-form__hint">Finding the right products, knowing what will sell, finding reliable suppliers, pricing, marketing, getting customers, starting with a small budget or growing sales.</p>
          <textarea class="input" id="Lead-challenge" name="challenge" rows="4" placeholder="Tell us in your own words"></textarea>
        </div>
      </div>

      <p class="lead-form__error" data-lead-error role="alert"></p>

      {%- comment -%}
        Lami's closing pitch. It belongs beside the button that submits, not
        halfway up a questionnaire, so the script reveals it with the submit
        button on the last question. Without the script it is simply always
        there, at the bottom, which is where it would be on a single long form.
      {%- endcomment -%}
      {% if section.settings.closing_heading != blank or section.settings.closing_body != blank %}
        <div class="lead-form__closing" data-lead-closing hidden>
          {% if section.settings.closing_heading != blank %}
            <h3>{{ section.settings.closing_heading }}</h3>
          {% endif %}
          {% if section.settings.closing_body != blank %}
            <div class="lead-form__closing-body">{{ section.settings.closing_body }}</div>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.consent != blank %}
        <div class="lead-form__consent">{{ section.settings.consent }}</div>
      {% endif %}

      <div class="lead-form__actions">
        <button type="button" class="btn btn--ghost" data-lead-back hidden>Back</button>
        <button type="button" class="btn btn--primary btn--block" data-lead-next>Next</button>
        <button type="submit" class="btn btn--primary btn--block" data-lead-submit hidden>
          Show me the right opportunities
        </button>
      </div>

      {% if section.settings.reassurance != blank %}
        <p class="lead-form__reassure">{{ section.settings.reassurance }}</p>
      {% endif %}
    </form>
  </div>
</section>

<script src="{{ 'lead-form.js' | asset_url }}" defer></script>

{% stylesheet %}
  .lead-section__inner {
    max-width: 40rem;
  }

  .lead-form {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-6) var(--space-5);
  }

  .lead-form__progress {
    height: 5px;
    border-radius: 999px;
    background: var(--color-border);
    overflow: hidden;
  }

  .lead-form__bar {
    height: 100%;
    width: var(--progress, 0%);
    background: var(--color-amber);
    transition: width 260ms ease;
  }

  .lead-form__count {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: var(--space-3) 0 var(--space-5);
  }

  /* Without the script every step is visible and the form still works, so the
     hidden attribute is only honoured once stepping is actually running. */
  .lead-form:not(.lead-form--stepped) .lead-form__step[hidden] {
    display: block;
  }

  .lead-form:not(.lead-form--stepped) .lead-form__progress,
  .lead-form:not(.lead-form--stepped) .lead-form__count,
  .lead-form:not(.lead-form--stepped) [data-lead-next],
  .lead-form:not(.lead-form--stepped) [data-lead-back] {
    display: none;
  }

  .lead-form:not(.lead-form--stepped) [data-lead-submit] {
    display: inline-flex;
  }

  .lead-form__step + .lead-form__step {
    margin-top: var(--space-6);
  }


  .lead-form__field {
    border: 0;
    padding: 0;
    margin: 0;
  }

  .lead-form__label {
    display: block;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.3;
    margin-bottom: var(--space-3);
    padding: 0;
  }

  .lead-form__hint {
    font-size: 0.86rem;
    color: var(--color-muted);
    margin-bottom: var(--space-4);
  }

  .lead-form__choices {
    display: grid;
    gap: var(--space-2);
  }

  /* A whole row that responds to a tap, rather than a small circle that has
     to be hit exactly. This form is mostly read on a phone. */
  .lead-choice {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-paper);
    font-size: 0.96rem;
    line-height: 1.35;
    cursor: pointer;
    transition: border-color 140ms ease, background 140ms ease;
  }

  .lead-choice:hover {
    border-color: var(--color-accent);
  }

  .lead-choice input {
    margin-top: 0.15em;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    accent-color: var(--color-accent);
  }

  .lead-choice:has(input:checked) {
    border-color: var(--color-accent);
    background: var(--color-amber-soft);
  }

  .lead-choice:has(input:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .lead-form__error {
    color: #b3261e;
    font-size: 0.88rem;
    font-weight: 700;
    margin: var(--space-4) 0 0;
    min-height: 1.2em;
  }

  .lead-form__consent {
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--color-muted);
    margin: var(--space-5) 0 var(--space-4);
  }

  .lead-form__consent p:last-child {
    margin-bottom: 0;
  }

  .lead-form__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* The buttons carry .btn, which sets display: inline-flex and so beats the
     browser's own rule for the hidden attribute. Without this, Back shows on
     the first question and Next shows alongside Submit on the last. */
  .lead-form [hidden] {
    display: none;
  }

  .lead-form__closing {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .lead-form__closing h3 {
    font-size: 1.05rem;
    margin-bottom: var(--space-3);
  }

  .lead-form__closing-body {
    font-size: 0.94rem;
    color: var(--color-muted);
  }

  .lead-form__closing-body p:last-child {
    margin-bottom: 0;
  }

  /* No script, no stepping, so the closing copy is simply always shown. */
  .lead-form:not(.lead-form--stepped) .lead-form__closing[hidden] {
    display: block;
  }

  .lead-form__reassure {
    text-align: center;
    font-size: 0.84rem;
    color: var(--color-muted);
    margin: var(--space-4) 0 0;
  }

  @media (min-width: 560px) {
    .lead-form {
      padding: var(--space-7) var(--space-6);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lead questionnaire",
  "settings": [
    {
      "type": "paragraph",
      "content": "Answers go to Omnisend. Switch Omnisend on under Theme settings, App embeds, or nothing is recorded. Name, email and WhatsApp number are sent as soon as they are given, so a half-finished form still leaves a lead."
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Anchor ID",
      "default": "questionnaire"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Section background",
      "options": [
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "paper",
          "label": "Paper (light grey)"
        },
        {
          "value": "mist",
          "label": "Mist (pale navy)"
        },
        {
          "value": "amber",
          "label": "Amber tint"
        },
        {
          "value": "aqua",
          "label": "Aqua tint"
        }
      ],
      "default": "paper"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "TELL US WHAT YOU ARE LOOKING FOR"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A few questions, then we can point you at the right stock"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Intro",
      "default": "It takes about two minutes. There is no obligation to buy anything."
    },
    {
      "type": "header",
      "content": "After the form"
    },
    {
      "type": "url",
      "id": "thanks_url",
      "label": "Thank-you page",
      "info": "Where people land once they finish. Leave blank and they go to /pages/thank-you."
    },
    {
      "type": "header",
      "content": "Shown on the last question"
    },
    {

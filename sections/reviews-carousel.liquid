{%- comment -%}
  Judge.me review carousel, for the home page and anywhere else proof helps.
  Renders nothing at all unless Judge.me is switched on in theme settings.
{%- endcomment -%}

{% if settings.enable_judgeme %}
  <section
    id="{{ section.settings.custom_id | default: section.id }}"
    class="reviews-carousel section section--{{ section.settings.background }}"
  >
    <div class="container">
      {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
        <div class="section-intro reveal">
          {% if section.settings.eyebrow != blank %}<span class="route-label route-label--amber">{{ section.settings.eyebrow }}</span>{% endif %}
          {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
        </div>
      {% endif %}

      {% render 'judgeme', type: 'carousel' %}

      {% if section.settings.cta_text != blank %}
        <div class="reviews-carousel__cta">
          <a href="{{ section.settings.cta_url | default: '/pages/reviews' }}" class="btn btn--secondary">{{ section.settings.cta_text }}</a>
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .reviews-carousel__cta {
    text-align: center;
    margin-top: var(--space-6);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Review carousel",
  "settings": [
    { "type": "text", "id": "custom_id", "label": "Anchor ID (optional)" },
    { "type": "select", "id": "background", "label": "Section background", "info": "Vary this down a page so each band reads as its own.", "options": [
        { "value": "paper", "label": "Paper (light grey)" },
        { "value": "white", "label": "White" },
        { "value": "mist", "label": "Mist (pale navy)" },
        { "value": "amber", "label": "Amber tint" },
        { "value": "aqua", "label": "Aqua tint" },
        { "value": "navy", "label": "Navy (dark)" }
      ], "default": "mist" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow / route label", "default": "REVIEWS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What buyers say" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Read all reviews" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Review carousel" }]
}
{% endschema %}

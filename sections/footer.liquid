{%- assign newsletter_posted = false -%}
{%- if form.posted_successfully? and form.id == 'FooterNewsletterForm' -%}
  {%- assign newsletter_posted = true -%}
{%- endif -%}

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <span class="site-header__wordmark">{{ shop.name }}</span>
        <p>{{ section.settings.brand_blurb }}</p>
        {% render 'social-icons' %}
      </div>

      <div class="site-footer__groups">
        {% for block in section.blocks %}
          {% if block.type == 'link_group' %}
            <div class="site-footer__group" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.heading }}</h3>
              <ul>
                {% for i in (1..7) %}
                  {% assign label_key = 'link' | append: i | append: '_label' %}
                  {% assign url_key = 'link' | append: i | append: '_url' %}
                  {% assign l_label = block.settings[label_key] %}
                  {% assign l_url = block.settings[url_key] %}
                  {% if l_label != blank and l_url != blank %}
                    <li><a href="{{ l_url }}">{{ l_label }}</a></li>
                  {% endif %}
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="site-footer__newsletter">
        <h3>{{ 'newsletter.heading' | t }}</h3>
        {%- comment -%}
          An email app placed here replaces the built-in form, so a shop using
          Klaviyo or similar collects into that rather than into two lists that
          disagree with each other.
        {%- endcomment -%}
        {%- liquid
          assign email_app = 0
          for block in section.blocks
            if block.type == '@app'
              assign email_app = email_app | plus: 1
            endif
          endfor
        -%}

        {% if email_app > 0 %}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                <div class="site-footer__app" {{ block.shopify_attributes }}>{%- render block -%}</div>
            {%- endcase -%}
          {%- endfor -%}
        {% else %}
        {% form 'customer', id: 'FooterNewsletterForm' %}
          {%- comment -%}
            Without this the customer record is created but not subscribed, so
            an email app has a contact it is not allowed to email. The form is
            a newsletter signup and says so, which is what makes ticking it
            here honest rather than presumed.
          {%- endcomment -%}
          <input type="hidden" name="contact[accepts_marketing]" value="true">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="site-footer__newsletter-row {% if form.errors %}has-error{% endif %}">
            <label class="visually-hidden" for="FooterNewsletterEmail">{{ 'newsletter.placeholder' | t }}</label>
            <input
              class="input"
              type="email"
              id="FooterNewsletterEmail"
              name="contact[email]"
              placeholder="{{ 'newsletter.placeholder' | t }}"
              autocomplete="email"
              required
            >
            <button type="submit" class="btn btn--primary">{{ 'newsletter.submit' | t }}</button>
          </div>
          <div class="form-status" {% if newsletter_posted %}data-state="success"{% elsif form.errors %}data-state="error"{% endif %}>
            {% if newsletter_posted %}
              {{ 'newsletter.success' | t }}
            {% elsif form.errors %}
              {{ 'newsletter.error' | t }}
            {% endif %}
          </div>
        {% endform %}
        {% endif %}
      </div>
    </div>

    <hr class="rule">

    <div class="site-footer__bottom">
      <a href="{{ routes.root_url }}" class="site-footer__logo" aria-label="{{ shop.name }} - Home">
        {% if settings.logo_light %}
          <img
            src="{{ settings.logo_light | image_url: width: 300 }}"
            alt="{{ shop.name }}"
            width="140"
            height="{{ 140 | divided_by: settings.logo_light.aspect_ratio }}"
            loading="lazy"
          >
        {% else %}
          {% render 'brand-lockup', tone: 'light' %}
        {% endif %}
      </a>
      <p class="site-footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      {% render 'payment-icons' %}
    </div>
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    background: var(--color-ink);
    color: var(--color-paper);
    padding-block: var(--space-8);
  }

  .site-footer__top {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 768px) {
    .site-footer__top {
      grid-template-columns: 1.2fr 2fr;
    }
  }

  @media (min-width: 1100px) {
    .site-footer__top {
      grid-template-columns: 1fr 2.2fr 1fr;
    }
  }

  .site-footer__brand p {
    color: color-mix(in srgb, var(--color-paper) 75%, transparent);
    margin-block: var(--space-3) var(--space-4);
    max-width: 32ch;
  }

  .site-footer__groups {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .site-footer__groups {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .site-footer__groups {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .site-footer__group h3 {
    font-family: var(--font-body);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-on-dark);
    margin-bottom: var(--space-3);
  }

  .site-footer__group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .site-footer__group a {
    color: var(--color-paper);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .site-footer__group a:hover {
    color: var(--color-accent-on-dark);
  }

  .site-footer__newsletter h3 {
    font-family: var(--font-body);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-on-dark);
    margin-bottom: var(--space-3);
  }

  .site-footer__newsletter-row {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .site-footer__newsletter-row .input {
    flex: 1 1 180px;
    background: color-mix(in srgb, var(--color-paper) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-paper) 30%, transparent);
    color: var(--color-paper);
  }

  .site-footer__newsletter-row .input::placeholder {
    color: color-mix(in srgb, var(--color-paper) 55%, transparent);
  }

  .site-footer .rule {
    border-color: color-mix(in srgb, var(--color-paper) 20%, transparent);
    margin-block: var(--space-7);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .site-footer__logo {
    display: inline-flex;
    text-decoration: none;
    font-size: 0.95rem;
    margin-right: auto;
  }

  .site-footer__logo img {
    height: auto;
    width: 140px;
  }

  .site-footer__copyright {
    margin: 0;
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--color-paper) 65%, transparent);
  }
{% endstylesheet %}


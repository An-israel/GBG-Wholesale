{%- comment -%}
  Product recommendations.

  Rendered on its own by Shopify's recommendations endpoint and injected into
  the product page, which is why it reads `recommendations` rather than looping
  a collection: the products are chosen from real order history rather than
  from a rule someone wrote.

  Two intents are available. "Related" is what other people viewed and bought
  alongside this. "Complementary" is what Shopify has been told goes with it,
  set per product in the Search & Discovery app. The heading changes to match,
  because "people who bought this also bought" and "complete your order" are
  different promises and should not be swapped at random.

  Falls back to a collection when there is not enough order history yet, so a
  new shop never shows an empty band where recommendations should be.
{%- endcomment -%}

{%- liquid
  assign items = recommendations.products

  if recommendations.performed == false or recommendations.products_count == 0
    assign fallback = section.settings.fallback_collection
    if fallback != blank
      assign items = fallback.products
    endif
  endif
-%}

{% if items.size > 0 %}
  <div class="related-products section section--{{ section.settings.background }}">
    <div class="container">
      <div class="section-intro">
        {% if section.settings.eyebrow != blank %}
          <span class="route-label route-label--amber">{{ section.settings.eyebrow }}</span>
        {% endif %}
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.body != blank %}<p>{{ section.settings.body }}</p>{% endif %}
      </div>

      <div class="grid grid--4">
        {% for product in items limit: section.settings.product_count %}
          {% if product.tags contains 'academy' %}{% continue %}{% endif %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Complementary products",
  "settings": [
    { "type": "paragraph", "content": "Products are chosen from real order history. Complementary recommendations are set per product in the free Search & Discovery app; related ones need no setup." },
    { "type": "select", "id": "background", "label": "Section background", "options": [
        { "value": "white", "label": "White" },
        { "value": "paper", "label": "Paper (light grey)" },
        { "value": "mist", "label": "Mist (pale navy)" },
        { "value": "amber", "label": "Amber tint" },
        { "value": "aqua", "label": "Aqua tint" }
      ], "default": "white" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "COMPLETE THE ORDER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "People who bought this also bought" },
    { "type": "text", "id": "body", "label": "Small line under the heading" },
    { "type": "range", "id": "product_count", "min": 2, "max": 8, "step": 1, "label": "Number of products", "default": 4 },
    { "type": "collection", "id": "fallback_collection", "label": "Show this collection if there is not enough order history yet", "info": "A new shop has no purchase data, so without a fallback this band would be empty." }
  ]
}
{% endschema %}

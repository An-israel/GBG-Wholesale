<section id="{{ section.settings.custom_id | default: section.id }}" class="pricing-calc section section--surface">
  <div class="container">
    <div class="section-intro reveal">
      {% if section.settings.eyebrow != blank %}<span class="route-label">{{ section.settings.eyebrow }}</span>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.body != blank %}<p>{{ section.settings.body }}</p>{% endif %}
    </div>

    <form class="pricing-calc__form card" data-pricing-calculator novalidate>
      <div class="pricing-calc__grid">
        <div class="field">
          <label class="field__label" for="CalcCost">Pack cost (£)</label>
          <input class="input" type="number" min="0" step="0.01" id="CalcCost" name="cost" inputmode="decimal" placeholder="e.g. 50" required>
          <span class="field__error">Enter the total cost of the pack.</span>
        </div>
        <div class="field">
          <label class="field__label" for="CalcQuantity">Units in pack</label>
          <input class="input" type="number" min="1" step="1" id="CalcQuantity" name="quantity" inputmode="numeric" placeholder="e.g. 10" required>
          <span class="field__error">Enter how many units are in the pack.</span>
        </div>
        <div class="field">
          <label class="field__label" for="CalcPackaging">Packaging cost per item (£)</label>
          <input class="input" type="number" min="0" step="0.01" id="CalcPackaging" name="packaging" inputmode="decimal" placeholder="e.g. 0.50" value="0.50">
        </div>
        <div class="field">
          <label class="field__label" for="CalcFee">Platform fee (%)</label>
          <input class="input" type="number" min="0" max="90" step="0.1" id="CalcFee" name="fee" inputmode="decimal" placeholder="e.g. 10" value="10">
          <span class="field__hint">Vinted, eBay and TikTok Shop fees vary - check your platform's current rate.</span>
        </div>
      </div>

      <button type="submit" class="btn btn--primary">Calculate minimum sell price</button>

      <div class="pricing-calc__result" data-pricing-result aria-live="polite" hidden>
        <span class="route-label route-label--amber">RESULT</span>
        <p class="pricing-calc__price"><span data-result-price>£0.00</span> minimum sell price per item</p>
        <p class="field__hint">This is your break-even price after packaging and platform fees - the lowest you should list at. Anything above it is profit.</p>
      </div>
    </form>
  </div>
</section>

{% stylesheet %}
  .pricing-calc__form {
    max-width: 640px;
    padding: var(--space-6);
  }

  .pricing-calc__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4) var(--space-5);
    margin-bottom: var(--space-5);
  }

  @media (max-width: 480px) {
    .pricing-calc__grid {
      grid-template-columns: 1fr;
    }
  }

  .pricing-calc__result {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .pricing-calc__result .route-label {
    margin-bottom: var(--space-3);
  }

  .pricing-calc__price {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-amber-text);
    margin: 0 0 var(--space-2);
  }
{% endstylesheet %}

<script src="{{ 'pricing-calculator.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Pricing calculator",
  "settings": [
    { "type": "text", "id": "custom_id", "label": "Anchor ID (optional)", "default": "pricing-calculator" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow / route label", "default": "TOOL" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pricing Calculator" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Work out your minimum sell price: cost ÷ quantity, plus packaging and platform fees." }
  ],
  "presets": [
    { "name": "Pricing calculator" }
  ]
}
{% endschema %}

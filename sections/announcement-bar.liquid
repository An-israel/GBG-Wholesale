{% if settings.show_announcement_bar %}
  <div class="announcement-bar">
    <div class="container announcement-bar__inner">
      <button type="button" class="announcement-bar__link" data-waitlist-trigger>
        <span>
          Ships from the UK in 3 days. New stock every <strong>{{ settings.restock_day | default: 'Thursday' }}</strong>.
        </span>
        <span class="announcement-bar__cue">Get restock alerts {% render 'icon', name: 'arrow-right' %}</span>
      </button>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .announcement-bar {
    background: var(--color-navy);
    color: #ffffff;
  }

  .announcement-bar__inner {
    padding-block: var(--space-2);
  }

  .announcement-bar__link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    width: 100%;
    background: none;
    border: none;
    color: inherit;
    font-size: 0.8rem;
    text-align: center;
    padding: var(--space-2);
    min-height: 44px;
  }

  .announcement-bar__cue {
    display: none;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    color: var(--color-amber);
    white-space: nowrap;
  }

  .announcement-bar__link svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .announcement-bar__cue {
      display: inline-flex;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": []
}
{% endschema %}

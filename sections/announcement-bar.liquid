{% if settings.show_announcement_bar %}
  <div class="announcement-bar">
    <div class="container announcement-bar__inner">
      <button type="button" class="announcement-bar__link" data-waitlist-trigger>
        <span class="route-label route-label--ink">LOT 01</span>
        <span>
          New stock drops every <strong>{{ settings.restock_day | default: 'Thursday' }}</strong>. Join the waitlist so you never miss a restock.
        </span>
        {% render 'icon', name: 'arrow-right' %}
      </button>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .announcement-bar {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .announcement-bar__inner {
    padding-block: var(--space-2);
  }

  .announcement-bar__link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    width: 100%;
    background: none;
    border: none;
    color: inherit;
    font-size: 0.8rem;
    text-align: center;
    padding: var(--space-2);
    min-height: 44px;
  }

  .announcement-bar__link .route-label {
    display: none;
  }

  .announcement-bar__link svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .announcement-bar__link .route-label {
      display: inline-flex;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": []
}
{% endschema %}

<div class="container section not-found reveal">
  <span class="route-label">GBG WHOLESALE HUB</span>
  <h1>{{ 'password.title' | t }}</h1>

  {% if shop.password_message %}
    <p>{{ shop.password_message }}</p>
  {% else %}
    <p>We're putting the finishing touches on the shop - enter the password below if you have early access.</p>
  {% endif %}

  {% form 'storefront_password' %}
    {% if form.errors %}
      <div class="form-status" data-state="error">{{ form.errors | default_errors }}</div>
    {% endif %}

    <div class="field">
      <label class="field__label visually-hidden" for="password-input">{{ 'password.password' | t }}</label>
      <input class="input" type="password" name="password" id="password-input" placeholder="{{ 'password.password' | t }}">
    </div>

    <button type="submit" class="btn btn--primary btn--block">{{ 'password.enter' | t }}</button>
  {% endform %}
</div>

{% schema %}
{
  "name": "Password page",
  "settings": []
}
{% endschema %}

<div id="products" class="collection container section section--{{ section.settings.background }}">
  {% if section.settings.show_header %}
    <div class="collection__header reveal">
      <span class="route-label">{{ collection.title | upcase }}</span>
      <h1>{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <div class="collection__description">{{ collection.description }}</div>
      {% endif %}
    </div>

    <div class="collection__banner card" data-reseller-banner>
      <p>
        <strong>Already reselling?</strong> The Learn Hub has platform guides and a pricing calculator built for exactly this.
        <a href="/pages/learn">Explore the Learn Hub &rarr;</a>
      </p>
    </div>
  {% endif %}

  {%- comment -%}
    Quick filters. These are plain links to Shopify's own tag filtering, so
    they work without JavaScript and are shareable as URLs. They sit above the
    full filter panel because these three questions ("can I order one?",
    "where do I sell it?") are the ones buyers actually arrive with.
  {%- endcomment -%}
  <div class="collection__quick">
    <span class="collection__quick-label">Quick filters</span>
    <a class="collection__pill{% unless collection.current_tags %} is-active{% endunless %}" href="{{ collection.url }}">All</a>
    <a class="collection__pill collection__pill--dropship{% if collection.current_tags contains 'dropship' %} is-active{% endif %}" href="{{ collection.url }}/dropship">Dropship, order 1</a>
    <a class="collection__pill{% if collection.current_tags contains 'low-moq' %} is-active{% endif %}" href="{{ collection.url }}/low-moq">Low MOQ</a>
    {% assign platform_tags = 'platform-vinted,platform-ebay,platform-tiktok,platform-marketplace' | split: ',' %}
    {% assign platform_names = 'Vinted,eBay,TikTok Shop,Facebook Marketplace' | split: ',' %}
    {% for tag in platform_tags %}
      <a
        class="collection__pill{% if collection.current_tags contains tag %} is-active{% endif %}"
        href="{{ collection.url }}/{{ tag }}"
      >{{ platform_names[forloop.index0] }}</a>
    {% endfor %}

    {%- comment -%}
      Price bands are their own collections rather than tags, because a price
      changes far more often than anyone remembers to retag a product. They
      leave the current collection, so they are set apart from the filters that
      narrow it.
    {%- endcomment -%}
    <span class="collection__quick-divider" aria-hidden="true"></span>
    <a class="collection__pill" href="/collections/under-50">Under &pound;50</a>
    <a class="collection__pill" href="/collections/under-100">Under &pound;100</a>
  </div>

  {% paginate collection.products by 24 %}
    <div class="collection__toolbar">
      <details class="collection__filters" {% if collection.current_vendor or collection.current_type %}open{% endif %}>
        <summary>
          {% render 'icon', name: 'chevron' %}
          {{ 'collections.filter' | t }}
        </summary>
        <form id="CollectionFilterForm" class="collection__filter-form">
          {% for filter in collection.filters %}
            <fieldset class="collection__filter-group">
              <legend>{{ filter.label }}</legend>
              {% if filter.type == 'price_range' %}
                <div class="collection__price-range">
                  <div class="field">
                    <label class="field__label" for="FilterPriceMin">Min £</label>
                    <input
                      class="input"
                      type="number"
                      id="FilterPriceMin"
                      name="{{ filter.min_value.param_name }}"
                      value="{{ filter.min_value.value | default: '' }}"
                      placeholder="0"
                      min="0"
                    >
                  </div>
                  <div class="field">
                    <label class="field__label" for="FilterPriceMax">Max £</label>
                    <input
                      class="input"
                      type="number"
                      id="FilterPriceMax"
                      name="{{ filter.max_value.param_name }}"
                      value="{{ filter.max_value.value | default: '' }}"
                      placeholder="Any"
                      min="0"
                    >
                  </div>
                </div>
              {% else %}
                {% for value in filter.values %}
                  <label class="collection__filter-checkbox">
                    <input
                      type="checkbox"
                      name="{{ value.param_name }}"
                      value="{{ value.value }}"
                      {% if value.active %}checked{% endif %}
                      {% if value.count == 0 and value.active == false %}disabled{% endif %}
                    >
                    {{ value.label }} ({{ value.count }})
                  </label>
                {% endfor %}
              {% endif %}
            </fieldset>
          {% endfor %}
          <button type="submit" class="btn btn--secondary btn--sm">Apply filters</button>
          {% if collection.filters != empty %}
            <a href="{{ collection.url }}" class="btn btn--ghost btn--sm">{{ 'collections.clear_filters' | t }}</a>
          {% endif %}
        </form>
      </details>

      <div class="collection__sort">
        <label class="visually-hidden" for="CollectionSort">{{ 'collections.sort_by' | t }}</label>
        <select class="input" id="CollectionSort" data-collection-sort>
          {% for option in collection.sort_options %}
            <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
          {% endfor %}
        </select>
      </div>
    </div>

    <p class="collection__count field__hint">{{ 'collections.results_count' | t: count: collection.products_count }}</p>

    {% if collection.products.size > 0 %}
      <div class="grid grid--4">
        {%- comment -%}
          The Academy is a product so it can be paid for at the normal
          checkout, but it isn't stock, so it stays out of the shop grid.
        {%- endcomment -%}
        {% for product in collection.products %}
          {% if product.tags contains 'academy' %}{% continue %}{% endif %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        {% render 'pagination', paginate: paginate %}
      {% endif %}
    {% else %}
      <div class="collection__empty">
        <p>{{ 'collections.no_products' | t }}</p>
        <p class="field__hint">{{ 'collections.no_products_body' | t }}</p>
        <a href="{{ collection.url }}" class="btn btn--secondary">{{ 'collections.clear_filters' | t }}</a>
      </div>
    {% endif %}
  {% endpaginate %}
</div>

{% stylesheet %}
  .collection__quick-divider {
    width: 1px;
    align-self: stretch;
    min-height: 24px;
    background: var(--color-border);
    margin-inline: var(--space-2);
  }

  .collection__header {
    margin-bottom: var(--space-5);
    max-width: 60ch;
  }

  .collection__header .route-label {
    margin-bottom: var(--space-3);
  }

  .collection__banner {
    padding: var(--space-4);
    margin-bottom: var(--space-6);
    background: color-mix(in srgb, var(--color-navy) 6%, var(--color-surface));
    border-color: var(--color-navy);
  }

  .collection__banner p {
    margin: 0;
    font-size: 0.9rem;
  }

  .collection__banner a {
    color: var(--color-navy);
    font-weight: 700;
  }

  .collection__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .collection__filters summary {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    list-style: none;
    min-height: 44px;
  }

  .collection__filters summary svg {
    width: 14px;
    height: 14px;
  }

  .collection__filters[open] summary svg {
    transform: rotate(180deg);
  }

  .collection__filter-form {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    max-width: 360px;
  }

  .collection__filter-group {
    border: none;
    padding: 0;
    margin: 0;
  }

  .collection__filter-group legend {
    font-weight: 700;
    font-size: 0.85rem;
    margin-bottom: var(--space-2);
  }

  .collection__filter-checkbox {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.9rem;
    padding: var(--space-1) 0;
  }

  .collection__price-range {
    display: flex;
    gap: var(--space-3);
  }

  .collection__sort select {
    min-width: 180px;
  }

  .collection__count {
    margin-bottom: var(--space-5);
  }

  .collection__empty {
    padding: var(--space-8) 0;
    text-align: center;
  }
{% endstylesheet %}

<script src="{{ 'collection.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Collection pages",
  "settings": [
    { "type": "checkbox", "id": "show_header", "label": "Show the title and description here", "info": "Switch off on category pages, where the hero above already shows them.", "default": true },
    { "type": "select", "id": "background", "label": "Section background", "options": [
        { "value": "white", "label": "White" },
        { "value": "paper", "label": "Paper (light grey)" },
        { "value": "mist", "label": "Mist (pale navy)" },
        { "value": "amber", "label": "Amber tint" },
        { "value": "aqua", "label": "Aqua tint" }
      ], "default": "white" }
  ]
}
{% endschema %}

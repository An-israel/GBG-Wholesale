<section id="{{ section.settings.custom_id | default: section.id }}" class="founder-note section section--{{ section.settings.background }}">
  <div class="container founder-note__inner reveal">
    {% if settings.founder_photo %}
      <img
        class="founder-note__photo"
        src="{{ settings.founder_photo | image_url: width: 200 }}"
        alt="Lami, founder of GBG Wholesale Hub"
        width="100"
        height="100"
        loading="lazy"
      >
    {% endif %}
    <div>
      {% if section.settings.heading != blank %}
        <span class="route-label route-label--navy">{{ section.settings.heading }}</span>
      {% endif %}
      <div class="founder-note__quote editorial">{{ settings.founder_note_body }}</div>
      <p class="rich-text__attribution">Lami</p>
    </div>
  </div>
</section>

{% stylesheet %}
  .founder-note__inner {
    display: grid;
    gap: var(--space-5);
    max-width: 68ch;
  }

  @media (min-width: 640px) {
    .founder-note__inner {
      grid-template-columns: auto 1fr;
      align-items: start;
    }
  }

  .founder-note__photo {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
  }

  .founder-note .route-label {
    margin-bottom: var(--space-3);
  }

  .founder-note__quote {
    font-size: 1.2rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Founder's note",
  "settings": [
    { "type": "text", "id": "custom_id", "label": "Anchor ID (optional)" },
    { "type": "select", "id": "background", "label": "Section background", "info": "Vary this down a page so each band reads as its own.", "options": [
        { "value": "paper", "label": "Paper (light grey)" },
        { "value": "white", "label": "White" },
        { "value": "mist", "label": "Mist (pale navy)" },
        { "value": "amber", "label": "Amber tint" },
        { "value": "aqua", "label": "Aqua tint" },
        { "value": "navy", "label": "Navy (dark)" }
      ], "default": "amber" },
    { "type": "text", "id": "heading", "label": "Eyebrow label", "default": "A Note From Lami" }
  ],
  "presets": [
    { "name": "Founder's note" }
  ]
}
{% endschema %}

<section id="{{ section.settings.custom_id | default: section.id }}" class="category-tiles section">
  <div class="container">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <div class="section-intro reveal">
        {% if section.settings.eyebrow != blank %}<span class="route-label">{{ section.settings.eyebrow }}</span>{% endif %}
        {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
      </div>
    {% endif %}

    <div class="category-tiles__grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.collection.url | default: block.settings.manual_url | default: '/collections/all' }}" class="category-tiles__tile reveal" {{ block.shopify_attributes }}>
          <div class="category-tiles__image">
            {% if block.settings.image %}
              <img
                src="{{ block.settings.image | image_url: width: 700 }}"
                srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 700 }} 700w"
                sizes="(min-width: 768px) 33vw, 50vw"
                alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                loading="lazy"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
              >
            {% elsif block.settings.collection.featured_image %}
              <img
                src="{{ block.settings.collection.featured_image | image_url: width: 700 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="700"
                height="700"
              >
            {% else %}
              <div class="category-tiles__placeholder" aria-hidden="true"></div>
            {% endif %}
          </div>
          <span class="category-tiles__label">
            {{ block.settings.title }}
            {% render 'icon', name: 'arrow-right' %}
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .category-tiles__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .category-tiles__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .category-tiles__grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .category-tiles__tile {
    text-decoration: none;
    color: var(--color-ink);
  }

  .category-tiles__image {
    aspect-ratio: 1;
    background: var(--color-surface);
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--color-border);
    transition: box-shadow 180ms ease;
  }

  .category-tiles__tile:hover .category-tiles__image {
    box-shadow: 0 2px 4px rgba(22, 24, 29, 0.05), 0 16px 32px rgba(22, 24, 29, 0.1);
  }

  .category-tiles__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .category-tiles__tile:hover .category-tiles__image img {
    transform: scale(1.04);
  }

  .category-tiles__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-paper), var(--color-border));
  }

  .category-tiles__label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: var(--space-3);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .category-tiles__label svg {
    width: 14px;
    height: 14px;
    color: var(--color-accent);
    flex-shrink: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category tiles",
  "settings": [
    { "type": "text", "id": "custom_id", "label": "Anchor ID (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow / route label", "default": "SHOP BY CATEGORY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop By Category" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Jewellery & Accessories" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "manual_url", "label": "Fallback link (used if no collection selected)" },
        { "type": "image_picker", "id": "image", "label": "Image (overrides collection image)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "Jewellery & Accessories" } },
        { "type": "tile", "settings": { "title": "Electronics" } },
        { "type": "tile", "settings": { "title": "Fashion" } },
        { "type": "tile", "settings": { "title": "Home & Lifestyle" } },
        { "type": "tile", "settings": { "title": "Starter Boxes" } }
      ]
    }
  ]
}
{% endschema %}

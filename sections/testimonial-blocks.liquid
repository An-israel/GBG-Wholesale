<section id="{{ section.settings.custom_id | default: section.id }}" class="testimonial-blocks section section--surface">
  <div class="container">
    <div class="section-intro reveal">
      {% if section.settings.eyebrow != blank %}<span class="route-label route-label--forest">{{ section.settings.eyebrow }}</span>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.body != blank %}<p>{{ section.settings.body }}</p>{% endif %}
    </div>

    <div class="testimonial-blocks__grid">
      {% for block in section.blocks %}
        <figure class="testimonial-blocks__item card reveal" {{ block.shopify_attributes }}>
          <div class="testimonial-blocks__image">
            {% if block.settings.image %}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                alt="{{ block.settings.caption | default: 'Community screenshot' | escape }}"
                loading="lazy"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
              >
            {% else %}
              <div class="testimonial-blocks__placeholder">
                <span class="route-label route-label--forest">SAMPLE WIN</span>
                <p>{{ block.settings.caption | default: 'Screenshot placeholder — add a real community win here.' }}</p>
              </div>
            {% endif %}
          </div>
          {% if block.settings.caption != blank and block.settings.image %}
            <figcaption>{{ block.settings.caption }}</figcaption>
          {% endif %}
        </figure>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .testimonial-blocks__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-5);
  }

  .testimonial-blocks__item {
    margin: 0;
    overflow: hidden;
  }

  .testimonial-blocks__image {
    aspect-ratio: 4 / 5;
    background: var(--color-paper);
  }

  .testimonial-blocks__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .testimonial-blocks__placeholder {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-5);
    text-align: center;
  }

  .testimonial-blocks__placeholder .route-label {
    margin-inline: auto;
  }

  .testimonial-blocks__item figcaption {
    padding: var(--space-4);
    font-size: 0.9rem;
    color: color-mix(in srgb, var(--color-ink) 75%, transparent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonial blocks",
  "settings": [
    { "type": "text", "id": "custom_id", "label": "Anchor ID (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow / route label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real women, real first sales" },
    { "type": "textarea", "id": "body", "label": "Body" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Screenshot" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Sold within days of ordering her first Starter Box." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonial blocks",
      "blocks": [
        { "type": "testimonial", "settings": { "caption": "Sold within days of ordering her first Starter Box." } },
        { "type": "testimonial", "settings": { "caption": "Cleared a whole pack in hours on Vinted." } },
        { "type": "testimonial", "settings": { "caption": "First Vinted sale in a week — no experience needed." } }
      ]
    }
  ]
}
{% endschema %}

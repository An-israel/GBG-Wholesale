<section id="{{ section.settings.custom_id | default: section.id }}" class="featured-products section section--{{ section.settings.background }}">
  <div class="container">
    <div class="section-intro reveal">
      {% if section.settings.eyebrow != blank %}<span class="route-label">{{ section.settings.eyebrow }}</span>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    </div>

    {%- liquid
      if section.settings.source == 'current' and collection != blank
        assign products = collection.products
      else
        assign products = section.settings.collection.products | default: collections.all.products
      endif
    -%}

    {% if products.size > 0 %}
      <div class="grid grid--4">
        {% for product in products limit: section.settings.product_count %}
          {% if product.tags contains 'academy' %}{% continue %}{% endif %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>
    {% else %}
      <p class="field__hint">Select a collection in the theme editor to feature products here.</p>
    {% endif %}

    {% if section.settings.show_cta %}
      <div class="featured-products__cta">
        <a href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}" class="btn btn--secondary">
          {{ section.settings.cta_text | default: 'Shop everything' }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .featured-products__cta {
    text-align: center;
    margin-top: var(--space-7);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GBG best sellers",
  "settings": [
    { "type": "text", "id": "custom_id", "label": "Anchor ID (optional)" },
    { "type": "select", "id": "background", "label": "Section background", "info": "Vary this down a page so each band reads as its own.", "options": [
        { "value": "paper", "label": "Paper (light grey)" },
        { "value": "white", "label": "White" },
        { "value": "mist", "label": "Mist (pale navy)" },
        { "value": "amber", "label": "Amber tint" },
        { "value": "aqua", "label": "Aqua tint" },
        { "value": "navy", "label": "Navy (dark)" }
      ], "default": "white" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow / route label", "default": "BEST SELLERS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "GBG best sellers" },
    { "type": "select", "id": "source", "label": "Products to show", "info": "\"This page's collection\" only works on a collection page, and follows that collection's own sort order, so set those collections to sort by best selling.", "options": [
        { "value": "picked", "label": "A collection I choose" },
        { "value": "current", "label": "This page's collection" }
      ], "default": "picked" },
    { "type": "collection", "id": "collection", "label": "Collection to pull from" },
    { "type": "range", "id": "product_count", "min": 2, "max": 8, "step": 1, "label": "Number of products", "default": 4 },
    { "type": "checkbox", "id": "show_cta", "label": "Show the \"shop everything\" button", "default": true },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Shop everything" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "presets": [
    { "name": "GBG best sellers" }
  ]
}
{% endschema %}

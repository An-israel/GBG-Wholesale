{%- comment -%}
  The thank-you page.

  Its own URL rather than a message swapped in on the form page, because an ad
  platform counts a conversion by someone reaching a page. A state change on
  the same URL is invisible to it.

  The community button is the only thing on the page that matters, so it is
  the only link above the fold.
{%- endcomment -%}

<section class="lead-thanks section section--{{ section.settings.background }}">
  <div class="container lead-thanks__inner">
    {% if section.settings.show_logo %}
      <div class="lead-thanks__brand">{% render 'brand-lockup' %}</div>
    {% endif %}

    <h1 class="lead-thanks__title">{{ section.settings.heading }}</h1>

    {% if section.settings.body != blank %}
      <div class="lead-thanks__body">{{ section.settings.body }}</div>
    {% endif %}

    {%- liquid
      assign join = section.settings.community_link | default: settings.reseller_community_link
    -%}

    {% if section.blocks.size > 0 %}
      <ul class="lead-thanks__list">
        {% for block in section.blocks %}
          <li {{ block.shopify_attributes }}>
            {% render 'icon', name: 'check' %}<span>{{ block.settings.text }}</span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {%- comment -%}
      A button with no link behind it looks broken and loses the lead at the
      last step, so with no link set the page says what is missing instead.
      Only visible in the theme editor, where it can be fixed.
    {%- endcomment -%}
    {% if join != blank %}
      <div class="lead-thanks__actions">
        <a href="{{ join }}" class="btn btn--primary btn--lg btn--block" target="_blank" rel="noopener noreferrer">
          {{ section.settings.cta_label }}
        </a>
        {% if section.settings.note != blank %}
          <p class="lead-thanks__note">{{ section.settings.note }}</p>
        {% endif %}
      </div>
    {% elsif request.design_mode %}
      <div class="lead-thanks__setup">
        <p><strong>No community link set.</strong></p>
        <p>
          Paste the WhatsApp invite link under
          <em>Theme settings &rsaquo; Reseller community link</em>, or in this
          section. Until then this page has no button and every lead stops here.
        </p>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .lead-thanks__inner {
    max-width: 40rem;
    padding-block: var(--space-7);
    text-align: center;
  }

  .lead-thanks__brand {
    margin-bottom: var(--space-6);
    display: flex;
    justify-content: center;
  }

  .lead-thanks__title {
    font-size: clamp(1.7rem, 1.2rem + 2.4vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    text-wrap: balance;
    margin-bottom: var(--space-4);
  }

  .lead-thanks__body {
    font-size: 1.02rem;
  }

  .lead-thanks__list {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    text-align: left;
  }

  .lead-thanks__list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: 0.98rem;
  }

  .lead-thanks__list svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 0.3em;
    color: var(--color-accent);
  }

  .lead-thanks__actions {
    margin-top: var(--space-7);
  }

  .lead-thanks__note {
    font-size: 0.86rem;
    color: var(--color-muted);
    margin: var(--space-3) 0 0;
  }

  /* Only ever seen inside the theme editor. */
  .lead-thanks__setup {
    margin-top: var(--space-6);
    padding: var(--space-5);
    border: 1px dashed color-mix(in srgb, var(--color-navy) 35%, transparent);
    border-radius: var(--radius);
    background: var(--color-surface);
    font-size: 0.9rem;
    text-align: left;
  }

  .lead-thanks__setup p:last-child {
    margin-bottom: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Thank you",
  "settings": [
    { "type": "select", "id": "background", "label": "Section background", "options": [
        { "value": "white", "label": "White" },
        { "value": "paper", "label": "Paper (light grey)" },
        { "value": "mist", "label": "Mist (pale navy)" },
        { "value": "amber", "label": "Amber tint" }
      ], "default": "white" },
    { "type": "checkbox", "id": "show_logo", "label": "Show the logo", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Thank you, we have got your details" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "header", "content": "The community button" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Join the free WhatsApp community" },
    { "type": "text", "id": "community_link", "label": "Community link", "info": "Leave blank to use the Reseller community link in Theme settings." },
    { "type": "text", "id": "note", "label": "Line under the button" }
  ],
  "blocks": [
    { "type": "point", "name": "Bullet", "settings": [
        { "type": "text", "id": "text", "label": "Text" }
      ] }
  ],
  "presets": [{ "name": "Thank you" }]
}
{% endschema %}

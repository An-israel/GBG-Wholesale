{% liquid
  assign published_date = article.published_at | date: '%B %d, %Y'
%}

<article class="container section article-page">
  <div class="article-page__header reveal">
    <span class="route-label">LEARN &rarr; {{ blog.title | upcase }}</span>
    <h1>{{ article.title }}</h1>
    <p class="field__hint">{{ 'blog.article_metadata_html' | t: date: published_date, author: article.author }}</p>
  </div>

  {% if article.image %}
    <img
      class="article-page__image"
      src="{{ article.image | image_url: width: 1200 }}"
      alt="{{ article.image.alt | default: article.title | escape }}"
      width="{{ article.image.width }}"
      height="{{ article.image.height }}"
      loading="eager"
    >
  {% endif %}

  <div class="article-page__content">{{ article.content }}</div>

  <a href="{{ blog.url }}" class="btn btn--secondary">{{ 'blog.back_to_blog' | t }}</a>

  {% if blog.comments_enabled? %}
    <div class="article-page__comments">
      <h2>{{ 'blog.article_comments' | t }}</h2>

      {% paginate article.comments by 10 %}
        {% for comment in article.comments %}
          <div class="article-page__comment">
            <p class="article-page__comment-author">{{ comment.author }}</p>
            <p class="field__hint">{{ comment.created_at | time_tag: format: 'date' }}</p>
            <p>{{ comment.content }}</p>
          </div>
        {% endfor %}

        {% if paginate.pages > 1 %}
          {% render 'pagination', paginate: paginate %}
        {% endif %}
      {% endpaginate %}

      {% form 'new_comment', article, class: 'card account-page__card' %}
        <h3>{{ 'blog.comment_form_title' | t }}</h3>

        {% if form.errors %}
          <div class="form-status" data-state="error">{{ 'forms.error_generic' | t }}</div>
        {% endif %}
        {% if form.posted_successfully? %}
          <div class="form-status" data-state="success">{{ 'forms.success_generic' | t }}</div>
        {% endif %}

        <div class="field">
          <label class="field__label" for="CommentAuthor">{{ 'blog.comment_form_name' | t }}</label>
          <input class="input" type="text" name="comment[author]" id="CommentAuthor" value="{{ form.author }}" required>
        </div>
        <div class="field">
          <label class="field__label" for="CommentEmail">{{ 'blog.comment_form_email' | t }}</label>
          <input class="input" type="email" name="comment[email]" id="CommentEmail" value="{{ form.email }}" required>
        </div>
        <div class="field">
          <label class="field__label" for="CommentBody">{{ 'blog.comment_form_body' | t }}</label>
          <textarea class="input" name="comment[body]" id="CommentBody" rows="4" required>{{ form.body }}</textarea>
        </div>
        <button type="submit" class="btn btn--primary">{{ 'blog.comment_form_submit' | t }}</button>
      {% endform %}
    </div>
  {% endif %}
</article>

{% stylesheet %}
  .article-page__header {
    max-width: 68ch;
    margin-bottom: var(--space-6);
  }

  .article-page__header .route-label {
    margin-bottom: var(--space-3);
  }

  .article-page__image {
    width: 100%;
    border-radius: var(--radius);
    margin-bottom: var(--space-6);
  }

  .article-page__content {
    max-width: 68ch;
    font-size: 1.05rem;
    margin-bottom: var(--space-6);
  }

  .article-page__comments {
    max-width: 68ch;
    margin-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-6);
  }

  .article-page__comment {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .article-page__comment-author {
    font-weight: 700;
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}

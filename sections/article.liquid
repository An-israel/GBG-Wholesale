{% liquid
  assign published_date = article.published_at | date: '%-d %B %Y'
%}

<article class="container section article-page">
  <div class="article-page__header reveal">
    {% if article.tags.size > 0 %}
      <a class="route-label route-label--amber" href="{{ blog.url }}/tagged/{{ article.tags.first }}">
        {{ article.tags.first | replace: '-', ' ' | upcase }}
      </a>
    {% else %}
      <span class="route-label route-label--amber">{{ blog.title | upcase }}</span>
    {% endif %}
    <h1>{{ article.title }}</h1>
    <p class="field__hint">{{ 'blog.article_metadata_html' | t: date: published_date, author: article.author }}</p>
  </div>

  {% if article.image %}
    <img
      class="article-page__image"
      src="{{ article.image | image_url: width: 1200 }}"
      alt="{{ article.image.alt | default: article.title | escape }}"
      width="{{ article.image.width }}"
      height="{{ article.image.height }}"
      loading="eager"
    >
  {% endif %}

  <div class="article-page__content">{{ article.content }}</div>

  <div class="article-page__next">
    <h2>Where to next</h2>
    <div class="article-page__next-actions">
      <a href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}" class="btn btn--primary">
        {{ section.settings.cta_label | default: 'Shop the stock' }}
      </a>
      <a href="/pages/learn" class="btn btn--secondary">Read the guides</a>
      <a href="{{ blog.url }}" class="btn btn--ghost">{{ 'blog.back_to_blog' | t }}</a>
    </div>
  </div>

  {% if blog.comments_enabled? %}
    <div class="article-page__comments">
      <h2>{{ 'blog.article_comments' | t }}</h2>

      {% paginate article.comments by 10 %}
        {% for comment in article.comments %}
          <div class="article-page__comment">
            <p class="article-page__comment-author">{{ comment.author }}</p>
            <p class="field__hint">{{ comment.created_at | time_tag: format: 'date' }}</p>
            <p>{{ comment.content }}</p>
          </div>
        {% endfor %}

        {% if paginate.pages > 1 %}
          {% render 'pagination', paginate: paginate %}
        {% endif %}
      {% endpaginate %}

      {% form 'new_comment', article, class: 'card account-page__card' %}
        <h3>{{ 'blog.comment_form_title' | t }}</h3>

        {% if form.errors %}
          <div class="form-status" data-state="error">{{ 'forms.error_generic' | t }}</div>
        {% endif %}
        {% if form.posted_successfully? %}
          <div class="form-status" data-state="success">{{ 'forms.success_generic' | t }}</div>
        {% endif %}

        <div class="field">
          <label class="field__label" for="CommentAuthor">{{ 'blog.comment_form_name' | t }}</label>
          <input class="input" type="text" name="comment[author]" id="CommentAuthor" value="{{ form.author }}" required>
        </div>
        <div class="field">
          <label class="field__label" for="CommentEmail">{{ 'blog.comment_form_email' | t }}</label>
          <input class="input" type="email" name="comment[email]" id="CommentEmail" value="{{ form.email }}" required>
        </div>
        <div class="field">
          <label class="field__label" for="CommentBody">{{ 'blog.comment_form_body' | t }}</label>
          <textarea class="input" name="comment[body]" id="CommentBody" rows="4" required>{{ form.body }}</textarea>
        </div>
        <button type="submit" class="btn btn--primary">{{ 'blog.comment_form_submit' | t }}</button>
      {% endform %}
    </div>
  {% endif %}
</article>

{% stylesheet %}
  .article-page__header {
    max-width: 68ch;
    margin-bottom: var(--space-6);
  }

  .article-page__header .route-label {
    margin-bottom: var(--space-3);
  }

  .article-page__image {
    width: 100%;
    border-radius: var(--radius);
    margin-bottom: var(--space-6);
  }

  .article-page__content {
    max-width: 68ch;
    font-size: 1.05rem;
    margin-bottom: var(--space-6);
  }

  .article-page__next {
    max-width: 68ch;
    margin-top: var(--space-7);
    padding: var(--space-5);
    border-radius: var(--radius);
    background: var(--color-paper);
    border: 1px solid var(--color-border);
  }

  .article-page__next h2 {
    font-size: 1.15rem;
    margin-bottom: var(--space-4);
  }

  .article-page__next-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .article-page__comments {
    max-width: 68ch;
    margin-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-6);
  }

  .article-page__comment {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .article-page__comment-author {
    font-weight: 700;
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Article",
  "settings": [
    { "type": "text", "id": "cta_label", "label": "Main button label", "default": "Shop the stock" },
    { "type": "url", "id": "cta_url", "label": "Main button link", "info": "Defaults to the full catalogue." }
  ]
}
{% endschema %}
